      <ns3:Restriction rdf:nodeID="Na8bf25da2ce04a608c9b5a1aaa918b38">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000506"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
