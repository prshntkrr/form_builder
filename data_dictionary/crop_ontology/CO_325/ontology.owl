    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N8e09b324acbd4674be0322e7f4017339">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000256"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observations on the margins and petiole wings should be made where the petiole and pseudostem meet at shooting. Margin is the part of the petiole that can be bent outwards/inwards. [x Observe at flowering time.]</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf212b0303249407fa6528ce74ee074ef">
