    <rdfs:label xml:lang="en">Ex: g/100 mL juice????</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010574">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Naa78a85b896c480fb4550f598f141391">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000957"/>
