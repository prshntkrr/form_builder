        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Open question</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Text"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000618">
