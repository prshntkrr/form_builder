      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculate as: the time elapsed between the Date of planting and the Date of first youngest leaf spotted, e.g. 24/06/2014 - 24/01/2014 = 151 days.</ns1:definition>
    <rdfs:label xml:lang="en">Time from planting to first youngest spotted leaf - computation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010356">
