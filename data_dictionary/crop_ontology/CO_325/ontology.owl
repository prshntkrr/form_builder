  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010352">
    <rdfs:label xml:lang="en">Average number of fingers in hand - hands - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nad0146ee4e004d118311f018be1a80de">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000324"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate as: the sum of the Number of fingers in hand, divided by the Number of hands in bunch, e.g. (10 + 10 + 11 + 10 + 10 + 10 + 12 + 12 + 12 + 11 +12 + 12 + 10 + 10 + 10 + 11) / 16 = 10.8.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100222">
