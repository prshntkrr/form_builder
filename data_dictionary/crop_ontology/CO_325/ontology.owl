        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000438"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Bunch position - estimation</rdfs:label>
    <ns1:definition xml:lang="en">Visually observe the angle of the bunch and choose the option that is most similar, from the 5 schematic drawings of descriptor 6.4.6 in the reference material.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
