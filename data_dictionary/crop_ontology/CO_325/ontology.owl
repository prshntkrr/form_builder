  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_325:0100094/2">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_325:0100094"/>
    <rdfs:label xml:lang="en">Stage 2 appears as a stripe, generally brown in colour and visible on the underside of the leaf, later the symptom also appears on the upper part of the limb as a stripe, the yellow colour of which resembles the stripe at stage 1 of Yellow Sigatoka. The colour of this stripe will change progressively from brown and later to black on the upper side of the limb, but will retain the brown colour on the underside.</rdfs:label>
    <ns1:altLabel xml:lang="en">2</ns1:altLabel>
  </rdf:Description>
