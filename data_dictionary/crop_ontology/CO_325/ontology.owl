  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0002051">
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Quality/Impression">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Trait"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Matooke astringency</rdfs:label>
    <ns2:attribute>Astringency</ns2:attribute>
    <ns1:definition xml:lang="en">complex sensation, accompanied by shrinking, drawing or puckering of the skin or mucosal surface in the mouth, produced by substances such as kaki tannins or sloe tannins</ns1:definition>
    <ns2:entity>Matooke</ns2:entity>
    <ns2:acronym xml:lang="en">MatAstr</ns2:acronym>
  </ns3:Class>
