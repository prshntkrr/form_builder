  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_325:0100096/6">
    <rdfs:label xml:lang="en">Third or mature spot stage: the centres of the lesions dry out becoming light grey or buff coloured and a bright yellow transitional zone appears between them and the normal green colour of the leaf. The lesions remain clearly visible after the leaf has collapsed or withered because of their light coloured centre and dark border.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_325:0100096"/>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
  </rdf:Description>
