    <ns2:acronym xml:lang="en">plantdens</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010040">
