  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010177">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N4d99ca189ddc45b9b5819e106b20f49e">
