        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120048">
    <ns1:definition xml:lang="en">Put in the mouth a piece of banana and Evaluate the force necessary to obtain the deformation of the product between the teeth during the first compression</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Sensory_descriptive_measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N04ea7b3dea3d42ebb47f0f0f10d4d8aa">
