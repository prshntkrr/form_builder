  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000237">
    <ns1:definition xml:lang="en">Cut a finger in half, crosswise at its widest point, and on the cross-section measure the width of the peel, using calipers. Associate the data with the Hand rank. The recommendation is to collect this data from six fingers in total - three fingers in the middle of the outer whorl from the second hand and from the second-most distal hand.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N6c3de4c0e015422280743162d2590cff">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000236"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Finger peel thickness - measurement</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010130">
    <ns1:definition xml:lang="en">Measure from the scar on the rachis until the beginning of the fruit. Record on the inner fruit in the middle of the mid-hand of the bunch. Tip: use string to measure or trace outline of fruit on paper. Record the exact value.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nc1385ae736a94c3e84882a21cb479251">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000493"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Fruit pedicel length - exact value - measurement</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100223">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:subClassOf>
