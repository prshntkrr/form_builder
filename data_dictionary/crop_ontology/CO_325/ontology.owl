  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000052">
    <ns1:definition xml:lang="en">Measure the length of a finger that is at the ready to eat stage, along the external (dorsal) arc, excluding the pedicel and the fruit tip, using a tape measure. Associate the data with the Hand rank and the Number of fingers measured. The recommendation is to collect this data from six fingers in total - three fingers in the middle of the outer whorl from the second hand and from the second-most distal hand.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N6164bce6dcde40538e26d842692eaa84">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000051"/>
