  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000043">
    <ns1:definition xml:lang="en">Count how many fingers are in a hand. Associate the data with the Hand rank. The recommendation is to collect this data from the second and second-most distal hands.</ns1:definition>
    <rdfs:label xml:lang="en">Number of fingers in hand - counting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:subClassOf>
