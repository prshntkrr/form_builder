  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010548">
    <ns1:definition xml:lang="en">80?C, for 14 days, or longer untill dry</ns1:definition>
    <rdfs:label xml:lang="en">Dry weight - measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbc8f36cabb8942e69bbc6dd82004ee50">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000931"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000066">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns2:attribute>Number of functional leaves</ns2:attribute>
    <ns1:definition xml:lang="en">The number of leaves on the plant that have 50 % or more of the leaf surface area as green, healthy, photosynthetic tissue.</ns1:definition>
    <ns2:acronym xml:lang="en">functleaves</ns2:acronym>
    <rdfs:label xml:lang="en">Number of functional leaves</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010144">
