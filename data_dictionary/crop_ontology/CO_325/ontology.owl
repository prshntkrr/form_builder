      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Firmness Sensory Texture method </rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010168">
    <ns1:definition xml:lang="en">The extent to which vascular discolouration extends up the pseudostem should be determined by making cross-section cuts, from the base of the pseudostem upwards, and examining the internal tissues following each cut. The point at which discolouration is no longer visible should be noted and the distance from this point to the pseudostem base recorded.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Extent of internal discolouration in corm of plant caused by Fusarium wilt - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nff501146324346878ceaaec772b95896">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000559"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120056">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Sensory_descriptive_measurement"/>
    <rdfs:subClassOf>
