    <rdfs:label xml:lang="en">leaf rank</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010003">
    <ns1:definition xml:lang="en">Record a description of the damage to the plant, e.g. leaves ripped, pseudostem snapped, plant toppled, etc.</ns1:definition>
    <rdfs:label xml:lang="en">Damage description - estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
