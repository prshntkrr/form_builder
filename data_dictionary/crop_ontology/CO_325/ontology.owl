    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010474">
    <rdfs:label xml:lang="en">Nematode stage - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N8cd60592dd1a4c35b37cd86250e08a8a">
