  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010561">
    <rdfs:label xml:lang="en">Fresh weight - measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Weighing</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ncbaf506dedc547e28c1dd2ea5b1d9459">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000944"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000226">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N7f25a83a781c49d5a172b13b06c414c2">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000225"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count how many sword suckers are in the mat.</ns1:definition>
    <rdfs:label xml:lang="en">Number of sword suckers - counting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100227">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N62122a749cab4e1a824617747815b394">
