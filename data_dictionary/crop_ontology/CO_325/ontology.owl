        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Visual counting method of Weevil traps (the trap should be minimum 30 cm long).</ns1:definition>
  </ns3:Class>
