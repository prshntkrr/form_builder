    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality/Aroma"/>
    <ns2:attribute>Grassy-like aroma</ns2:attribute>
    <ns2:acronym xml:lang="en">MatAroGrassA</ns2:acronym>
    <ns2:entity>Matooke</ns2:entity>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000628">
    <ns2:attribute>Body length</ns2:attribute>
    <rdfs:label xml:lang="en">Banana weevil adult body length</rdfs:label>
    <ns1:definition xml:lang="en">The length of a banana weevil adult body, from the head to the tip of the abdomen.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000124">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N9915338f070f4970ba92a13f347cd9c3">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000123"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Select at random five functional primary roots, at least 10 cm long. Reduce the length of the five selected roots to 10 cm and slice through the roots length-wise. Evaluate one half of each of the five roots for the percentage of root cortex showing necrosis. The maximum root necrosis per root half can be 20 %, giving a maximum root necrosis of 100 % for the five halves together. Mentally determine the necrosis of the individual roots (1 to 5) and sum these together to get the total root necrosis of the sample.</ns1:definition>
    <rdfs:label xml:lang="en">Root necrosis caused by nematodes - estimation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000584">
