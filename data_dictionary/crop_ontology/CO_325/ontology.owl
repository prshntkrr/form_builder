  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000034">
    <ns1:definition xml:lang="en">Harvest the bunch by cutting the peduncle 10 cm above the first ridge above the most proximal, hand and immediately below the most distal hand and weigh the bunch (including the rachis), using scales.</ns1:definition>
    <rdfs:label xml:lang="en">Bunch weight - measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N61f7b0ae58bb49c589a0ca44855ebfe0">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000033"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000120">
    <rdfs:label xml:lang="en">Percentage of dead roots</rdfs:label>
    <ns1:definition xml:lang="en">The percentage of all roots in a standard-size excavation of 20 x 20 x 20 cm extending outwards from the corm of the plant that are dead.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns2:attribute>Percentage of dead roots</ns2:attribute>
  </ns3:Class>
