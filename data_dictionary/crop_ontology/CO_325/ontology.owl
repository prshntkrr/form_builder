  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010067">
    <ns1:definition xml:lang="en">Calculate as: the Number of plants planted, minus the Number of plants dead, minus the Number of plants harvested, e.g. 24 - 4 - 18 = 2.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N095cec2587c94b27926c10727d2bbde1">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000367"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Number of plants not harvested - computation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010549">
