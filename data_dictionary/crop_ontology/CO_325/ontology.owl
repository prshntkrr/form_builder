    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure the length (y) of a projection/outline of the male bud on paper, with a measuring tape or ruler.</ns1:definition>
