  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000115">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate as: the Number of dead roots plus the Number of functional roots, e.g. 8 + 12 = 20 roots.</ns1:definition>
