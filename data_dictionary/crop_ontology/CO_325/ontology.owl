        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000938"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count the number of leaves</ns1:definition>
    <rdfs:label xml:lang="en">Leaf number - counting</rdfs:label>
  </ns3:Class>
