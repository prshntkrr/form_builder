  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000634">
    <rdfs:label xml:lang="en">Banana weevil adult average body weight</rdfs:label>
    <ns2:attribute>Average body weight</ns2:attribute>
    <ns1:definition xml:lang="en">The average weight of a banana weevil adult body.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000081">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns2:attribute>Combined percentage with internal symptoms of Fusarium wilt</ns2:attribute>
    <rdfs:label xml:lang="en">Percentage of plants with internal disease symptoms caused by Fusarium wilt</rdfs:label>
    <ns1:definition xml:lang="en">The percentage of plants with any or multiple of the internal disease symptoms - discolouration in the corm, and/or discolouration in the pseudostem, caused by Fusarium wilt.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100097">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nb56caed0a3e7423880babd3839e79483">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0010200"/>
