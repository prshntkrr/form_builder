  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010072">
    <rdfs:label xml:lang="en">Non-harvest proportion - computation</rdfs:label>
    <ns1:definition xml:lang="en">Calculate as: the Number of plants not harvested, divided by the Number of plants planted, e.g. 2 / 24 = 0.08.</ns1:definition>
