        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000548"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Record the rank (order) of the oldest standing leaf (with an erect petiole), counting the rank by starting with the youngest completely unrolled leaf as 1 and moving downwards, associating the data with the Date of data collection.</ns1:definition>
  </ns3:Class>
