  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000650">
    <ns1:definition xml:lang="en">The amount of damage to the inner corm (central cylinder) upper cross-section, assessed by the percentage of tunnels caused by weevils.</ns1:definition>
    <rdfs:label xml:lang="en">Percentage damage to upper cross-section inner corm caused by weevils</rdfs:label>
    <ns2:attribute>Damage percent X-upper-inner</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010069">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Neb4806e132684440892136f73d001246">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000371"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Death density - computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate as: the Plant density multiplied by the Death proportion, e.g. 1,667 * 0.17 = 283.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120069">
