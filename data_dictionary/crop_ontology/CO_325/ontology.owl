    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Naabbed3cf41d4319a7a6afd8b8760483">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0010152"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">nematodes/unit of fresh root weight</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010078">
    <rdfs:label xml:lang="en">Fruit pendulance - estimation</rdfs:label>
    <ns1:definition xml:lang="en">Visual estimation of fruit pendulance on a bunch, for Early Evaluation Trial stage only.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf9908ee0fe4a4e5fb3f4a703f4200224">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000389"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120047">
    <ns2:entity>Boiled plantain</ns2:entity>
    <rdfs:label xml:lang="en">Boiled plantain Firmness</rdfs:label>
    <ns2:attribute>Firmness</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality/Texture_in_mouth"/>
    <ns2:acronym xml:lang="en">BoiPlantnFirm</ns2:acronym>
    <ns1:definition xml:lang="en">Force required to obtain deformation, penetration or rupture of the banana</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010029">
    <rdfs:label xml:lang="en">Number of water suckers - counting</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N2195643e0c2c41fdae5b5b6010d1b2e0">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000310"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count how many water suckers are in the mat.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010558">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Water loss - measurement</rdfs:label>
    <ns1:definition xml:lang="en">Weighing of water loss though plant between timepoints (refer to experimental metadata)</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N58e935dc67a5463ab320d70c9d5d60e8">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000941"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000292">
    <rdfs:label xml:lang="en">Time from flowering to harvest</rdfs:label>
    <ns2:attribute>Time from flowering to harvest</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns2:acronym xml:lang="en">flower2harvest</ns2:acronym>
    <ns1:definition xml:lang="en">The time elapsed from flowering (when the last bracts fall from the most distal hand to display the female flowers) to the harvest of the bunch.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000100">
    <rdfs:label xml:lang="en">Youngest leaf spotted - counting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N4d0cba97228c4808bbfba19dadef72da">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000099"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Record the rank (order) of the youngest leaf spotted (the first fully unfurled leaf with at least 10 discrete, mature, necrotic lesions or one large necrotic area with 10 light-coloured dry centres), counting the rank by starting with the youngest completely unrolled leaf as 1 and moving downwards, associating the data with the Date of data collection.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100058">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:label xml:lang="en">rachis angle scale (1 to 2)</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nb26dd693348a4548a26dbe98b05a90fb">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0010109"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000520">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns2:attribute>Population density</ns2:attribute>
    <ns1:definition xml:lang="en">Number of nematodes in soil</ns1:definition>
    <rdfs:label xml:lang="en">Nematode population density by species in soil</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000286">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns1:definition xml:lang="en">The date the bunch is harvested from the plant.</ns1:definition>
    <rdfs:label xml:lang="en">Date of harvest</rdfs:label>
    <ns2:acronym xml:lang="en">dateharvest</ns2:acronym>
    <ns2:attribute>Date of harvest</ns2:attribute>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010173">
    <ns1:definition xml:lang="en">Mark the youngest completely unrolled leaf and record its rank, which is always 1. Associate the data with the Date of data collection.</ns1:definition>
    <rdfs:label xml:lang="en">Rank of marked youngest leaf - counting</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ned81cf0316664c7288eaaba0cf075756">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000564"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:00012019">
    <rdfs:label xml:lang="en">Firmness in mouth method</rdfs:label>
    <ns1:definition xml:lang="en">Put a part of the sample in your mouth, evaluate during the first bite (between molars) how hard is the sample.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Sensory_descriptive_measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nd5b95fc02ff74d918b953de934bbdeea">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0002044"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000007">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Plant crop cycle - computation</rdfs:label>
    <ns1:definition xml:lang="en">Calculate as: the time elapsed between the Date of planting to the Date of harvest. E.g. 24/12/2014 - 24/01/2014 = 334 days.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N24edbf0b65e74717941fab800297e623">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000006"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000083">
