    <rdfs:label xml:lang="en">Tallest sucker number of functional leaves - counting</rdfs:label>
    <ns1:definition xml:lang="en">Count how many functional leaves (leaves that have 50% or more of their surface as green, healthy, photosynthetic tissue) are on the tallest sucker.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N3860b534222e4b07b90ab617c57891a9">
