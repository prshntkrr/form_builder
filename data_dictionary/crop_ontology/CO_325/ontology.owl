    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Number of fingers in bunch - counting</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000574">
    <ns1:definition xml:lang="en">An indication of the extent of damage on an individual leaf caused by black leaf streak disease.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns2:acronym xml:lang="en">BLS</ns2:acronym>
    <ns2:attribute>Black leaf streak disease severity</ns2:attribute>
    <rdfs:label xml:lang="en">Black leaf streak disease severity</rdfs:label>
  </ns3:Class>
