    <ns1:definition xml:lang="en">The rank (order) of the oldest (most-distal) standing leaf (with an erect petiole).</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010254">
    <ns1:definition xml:lang="en">Cut the hands off from the rachis and weigh all the hands together, using scales.</ns1:definition>
