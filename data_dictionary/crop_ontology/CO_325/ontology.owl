        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000684"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Record the rank (order) of the second-most distal hand in the bunch, starting with the hand at the proximal end (closest to the pseudostem) of the bunch as 1 and continuing to the hand at the most distal end (closest to the male bud).</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:label xml:lang="en">Hand rank - counting</rdfs:label>
    <rdfs:subClassOf>
