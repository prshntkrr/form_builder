    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns2:attribute>Combined proportion of plants not harvested</ns2:attribute>
    <ns1:definition xml:lang="en">The proportion of plants that are alive but not harvested (e.g. due to slow or poor development), from the number of plants planted.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000954">
    <ns2:attribute>Growth</ns2:attribute>
