  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_325:0100095/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_325:0100095"/>
    <rdfs:label xml:lang="en">First-spot stage: the streak broadens and becomes more or less fusiform and elliptical in outline and similar to the first-spot stage of Sigatoka (Leach 1946). The transition from streak to spot is further characterised by the development of a light brown, water-soaked border around the spot. This water-soaked effect is especially clear in the early morning, when dew is still present on the leaf, or after rain.</rdfs:label>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
