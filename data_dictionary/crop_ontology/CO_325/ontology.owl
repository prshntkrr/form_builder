  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010339">
    <rdfs:label xml:lang="en">Off-type description - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N0c76093e3c8c4d21ab93bd65e79323f6">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000709"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Record a description of what made the plant recogniseable as an off-type.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:00012021">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Sensory_descriptive_measurement"/>
    <ns1:definition xml:lang="en">Put a part of the sample in mouth, chew it and after 5 chews, evaluate between tongue and palate the number and the size of the particles.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N8568425bbdde4a739a12a861ca1a99ab">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0002046"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Smoothness in mouth method</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000221">
    <ns1:definition xml:lang="en">The number of maiden suckers (fully grown suckers with foliage leaves) in the mat.</ns1:definition>
