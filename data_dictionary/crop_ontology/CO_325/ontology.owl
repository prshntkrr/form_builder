    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000078">
    <rdfs:label xml:lang="en">Percentage of plants with external disease symptoms caused by Fusarium wilt</rdfs:label>
    <ns2:attribute>Combined percentage with external symptoms of Fusarium wilt</ns2:attribute>
    <ns1:definition xml:lang="en">The percentage of plants with any or multiple of the external disease symptoms - yellowing leaves, splitting of pseudostem base, changes in new leaves, petiole collapse, caused by Fusarium wilt.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120061">
    <rdfs:label xml:lang="en">Stickiness scale 0-10</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ncfb4fa87cd8d44c4a7a02ef66ac424fd">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0120060"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000950">
