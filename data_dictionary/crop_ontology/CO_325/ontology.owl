  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010291">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Average damage to the corm weevils - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N823373100d8c4b8ab2e4f9b53cac5588">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000681"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculate as: the sum of Damage to inner corm upper cross-section caused by weevils, Damage to outer corm upper cross-section caused by weevils, Damage to inner corm lower cross-section caused by weevils, and Damage to outer corm lower cross-section caused by weevils, divided by the number of traits included in the sum, e.g. (25 + 36 + 18 + 20) / 4 = 24.8.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000523">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns2:attribute>Population density</ns2:attribute>
