  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010053">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Average finger internal length - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N7b6f00f0d2e44dd48d97061902d7a17f">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000341"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculate as: the sum of the Finger internal length measurements, divided by the number of those measurements, e.g. (27 + 31 + 29 + 30 + 30 + 28) / 6 = 29.2.</ns1:definition>
  </ns3:Class>
