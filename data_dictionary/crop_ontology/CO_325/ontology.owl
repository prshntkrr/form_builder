    <rdfs:label xml:lang="en">Number of fingers in 2nd-most distal hand - counting</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000377">
    <ns2:acronym xml:lang="en">nonharvprop</ns2:acronym>
