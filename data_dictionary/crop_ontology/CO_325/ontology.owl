  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000126">
    <ns1:definition xml:lang="en">The extent of root knot nematodes, observed externally as galls on the roots.</ns1:definition>
    <rdfs:label xml:lang="en">Nematode root knot galling extent</rdfs:label>
    <ns2:attribute>Extent of root knot nematodes</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
