  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_325:0100095/6">
    <rdfs:label xml:lang="en">Third or mature spot stage: the centre of the spot dries out, becoming light grey or buff-coloured, and further depressed. The spot is surrounded by a narrow, well-defined, dark brown or black border. between the latter and the normal green colour of the leaf, there is often a bright yellow transitional zone. After the leaf has collapsed and withered, spots remain clearly visible because of the light-coloured centre and dark border.</rdfs:label>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_325:0100095"/>
  </rdf:Description>
