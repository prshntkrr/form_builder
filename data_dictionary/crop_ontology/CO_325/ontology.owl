    <ns1:definition xml:lang="en">The relative water content in the whole plant</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns2:attribute>Content</ns2:attribute>
  </ns3:Class>
