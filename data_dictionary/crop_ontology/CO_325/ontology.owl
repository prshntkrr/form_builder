    <ns1:definition xml:lang="en">The number of leaves on a plant with a black leaf streak disease severity grade of 2.</ns1:definition>
    <rdfs:label xml:lang="en">Number of leaves with black leaf streak disease severity grade 2</rdfs:label>
  </ns3:Class>
