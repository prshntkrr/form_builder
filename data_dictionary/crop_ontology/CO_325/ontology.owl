    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Ratio of non green to green plant pixels</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N1a17dc924dc4473c8eddee51be9dcb45">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000927"/>
