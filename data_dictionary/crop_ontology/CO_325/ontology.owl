      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Winged petiole margin - estimation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010117">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbb7452e7c15d4c53bf6f175f358ef032">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000461"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Visually observe the last bract to lift from the hands, ideally when the bract has lifted to a horizontal position, and choose the option that is most similar, from the 2 photos of descriptpr 6.5.12 in the reference material.</ns1:definition>
    <rdfs:label xml:lang="en">Bract behaviour before falling - estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
