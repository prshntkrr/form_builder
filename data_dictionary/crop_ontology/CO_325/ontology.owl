  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010037">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nb7548953776949c8ba345a4594ee0eb9">
