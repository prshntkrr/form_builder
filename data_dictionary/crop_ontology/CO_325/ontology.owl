    <ns2:attribute>Vitamin C content</ns2:attribute>
    <ns1:definition xml:lang="en">The Vitamin C content of freeze-dried smashed pulp of a mature fruit</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010001">
    <ns1:definition xml:lang="en">Record the date of event.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nfd2cc2ce75da4971b13912c5b84f1d5f">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000269"/>
