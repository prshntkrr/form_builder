  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010022">
    <ns1:definition xml:lang="en">Measure the distance from the collar, or from the pseudostem base at the ground if the collar is not visible, to under the neck of the curved peduncle, using a measuring pole or sliding ruler.</ns1:definition>
