  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000265">
    <rdfs:label xml:lang="en">Petiole margin colour - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N73d443c08f2e4e51b4f17e95c57a0a75">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000264"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Observations on the margins and petiole wings should be made where the petiole and pseudostem meet at shooting. Use colour chart A and observe out of direct sunlight. Record the colour of the margin (general colour is below the rim). [x Observe at flowering time.]</ns1:definition>
  </ns3:Class>
