        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0010072"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">plants not harvested/plants planted</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000430">
    <ns1:definition xml:lang="en">Colour of the blotches on the upper leaf sheath of the petiole base.</ns1:definition>
    <rdfs:label xml:lang="en">Blotches colour at the petiole base</rdfs:label>
    <ns2:attribute>Main colour</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000314">
    <ns2:attribute>Weight</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <rdfs:label xml:lang="en">Rachis weight</rdfs:label>
    <ns1:definition xml:lang="en">The weight of the rachis.</ns1:definition>
    <ns2:acronym xml:lang="en">rachisweight</ns2:acronym>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0120003">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:label xml:lang="en">yellowness scale 0-10</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf405e392676743df9d994411f66fe287">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0120043"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000079">
    <ns1:definition xml:lang="en">Calculate as: the sum of the number of plants with any or multiple of the external disease symptoms caused by Fusarium wilt - yellowing leaves, splitting of pseudostem base, changes in new leaves, petiole collapse - divided by the Number of plants planted * 100, e.g. 112 / 300 * 100 = 37%.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nedfb5c8f02a84e01b36952d50b6153ea">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000078"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Percentage of plants with external disease symptoms caused by Fusarium wilt - computation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000514">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns2:attribute>Aromas</ns2:attribute>
    <ns1:definition xml:lang="en">The pulp aroma of the smashed pulp of a mature fruit</ns1:definition>
    <rdfs:label xml:lang="en">Fruit smashed pulp aroma/smell</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100096">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Na53ba046d8e24dd1a82eba3cec811c8d">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0010181"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Meredith and Lawrence (1969) - condensed</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000553">
    <ns2:attribute>Date a tagged leaf presents black leaf streak disease symptoms at Foures black leaf streak disease severity grade 1</ns2:attribute>
    <ns1:definition xml:lang="en">The date a tagged leaf presents black leaf streak disease symptoms at Foures black leaf streak disease severity grade 1.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <rdfs:label xml:lang="en">Date of tagged leaf presenting black leaf streak disease symptoms at Foures stage 1</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000073">
    <ns1:definition xml:lang="en">The extent to which vascular discolouration extends up the pseudostem of the tallest sucker should be determined by making cross-section cuts, from the base of the pseudostem upwards, and examining the internal tissues following each cut. The point at which discolouration is no longer visible should be noted and the distance from this point to the pseudostem base recorded.</ns1:definition>
    <rdfs:label xml:lang="en">Extent of internal discolouration in corm of tallest sucker caused by Fusarium wilt - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N743b473465c24c9892175c7b97e3b97a">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000072"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000248">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns1:definition xml:lang="en">Presence or absence of colour line along edge of petiole margin</ns1:definition>
    <ns2:attribute>Presence</ns2:attribute>
    <rdfs:label xml:lang="en">Colour line along edge of petiole margin</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000121">
    <ns1:definition xml:lang="en">Calculate as: the Number of dead roots divided by the Number of all roots, multiplied by 100, e.g. 8 / 20 * 100 = 40 % dead roots.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N1524c033e45d424bb8928ece7875e0ab">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000120"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Percentage of dead roots - computation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000955">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <rdfs:label xml:lang="en">Height increase of pseudostem</rdfs:label>
    <ns1:definition xml:lang="en">Pseudostem height increase over time</ns1:definition>
    <ns2:attribute>Growth</ns2:attribute>
    <ns2:acronym xml:lang="en">pseudostemHeightIncrease</ns2:acronym>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000941">
    <ns1:definition xml:lang="en">The amount of water loss through the plant over time</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <rdfs:label xml:lang="en">Plant water loss</rdfs:label>
    <ns2:acronym xml:lang="en">waterLossPlant</ns2:acronym>
    <ns2:attribute>Volume</ns2:attribute>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000028">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N638b4a6e026f42148ec850f1713b2a52">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000027"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">On the tallest sucker, measure the distance from the pseudostem base at the ground to the intersection of the petioles of the two youngest leaves (leaf ranks 1 and 2), using a measuring pole or sliding ruler.</ns1:definition>
    <rdfs:label xml:lang="en">Tallest sucker height - measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000151">
    <ns1:definition xml:lang="en">Count from 10 g of chopped roots from the tested banana plant sample</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nfcb582bc50b94d43b1bef9d43f151570">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000543"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Number of nematodes (Pratylenchus coffeae) per unit fresh root weight -method</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010448">
    <ns1:definition xml:lang="en">Calculate as: the Rank of previously marked leaf at one point in time, minus 1 (equivalent to the Rank of marked youngest leaf), divided by the time elapsed between the two Date of data collection events when the marked leaf was recorded as 1) the Rank of marked youngest leaf and 2) the Rank of previously marked leaf, e.g. (2 - 1) / 1 week = LER of 1 leaves/week during a particular time period.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Weekly leaf emission rate - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N902eac63cc0e487fbdab473a50ef83fe">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000726"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0002052">
    <ns2:entity>Matooke</ns2:entity>
    <ns2:attribute>Sourness</ns2:attribute>
