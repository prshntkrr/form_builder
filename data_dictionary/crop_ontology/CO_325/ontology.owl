  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000566">
    <ns2:attribute>Rank</ns2:attribute>
    <ns2:acronym xml:lang="en">rankprevleaf</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns1:definition xml:lang="en">The current rank (position) of the leaf that was previously marked as the youngest leaf at the time of the last data collection event.</ns1:definition>
    <rdfs:label xml:lang="en">Rank of previously marked leaf</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010124">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbe99026c66c4407ba0f235b4137411ec">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000480"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Number of fruits on mid-hand of the bunch - counting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">Count only fully developed fruit. If there is an even number of hands, there will be two middle hands. Count the middle hand that developed first.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010096">
