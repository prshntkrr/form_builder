  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010290">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Cut a transverse cross section of the corm at 10 cm below the collar (lower cross-section). Score weevil damage (galleries) as percentage damage on the side of the cross-section that was facing the ground, downwards.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N016e3110e4bc4426a056e9dc76ca11b7">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000679"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Damage to lower outer corm weevils - measurement</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:00012018">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Sensory_descriptive_measurement"/>
    <ns1:definition xml:lang="en">When you receive the sample, observe the surface and evaluate the  homogeneity </ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N84546de53c3d44b7a620aa3a83e86dbe">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0002043"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Surface color homogeneity Appearance method</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000230">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ncd044a2740d4426681c9abb4c86cb1c6">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000229"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Count how many peeper suckers are in the mat.</ns1:definition>
    <rdfs:label xml:lang="en">Number of peeper suckers - counting</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010014">
    <rdfs:label xml:lang="en">Time from flowering to harvest - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nc3d9a0277ca44536afc2916c9e6a8575">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000292"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate as: the time elapsed between the Date of flowering to the Date of harvest, e.g. 24/12/2014 - 24/10/2014 = 61 days.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000921">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns2:attribute>Area</ns2:attribute>
    <ns1:definition xml:lang="en">The projected leaf area of a plant (photosynthetic surface)</ns1:definition>
    <ns2:acronym xml:lang="en">topLeafArea</ns2:acronym>
    <rdfs:label xml:lang="en">Projected top area</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000112">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">Collect all roots from a standard-size excavation of 20 x 20 x 20 cm extending outwards from the corm of the plant. Take only roots from the selected plant. Divide the collected roots into two categories: dead roots, functional roots. Dead roots are completely rotten or shrivelled whereas functional roots show at least some healthy tissue. Count the number of functional roots.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nae3ee14955b6425eaf91991c9b88b61c">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000111"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Number of functional roots - counting</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010326">
    <ns1:definition xml:lang="en">Record the date and time of event.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">End date and time of data collection - estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N5c4de3234e6f41189f541393f59dfcfc">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000688"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000928">
    <rdfs:label xml:lang="en">Leaf dry weight</rdfs:label>
    <ns2:attribute>Dry weight</ns2:attribute>
    <ns1:definition xml:lang="en">The dry weight of a leaf</ns1:definition>
    <ns2:acronym xml:lang="en">leafDryMass</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010049">
    <ns1:definition xml:lang="en">Calculate as: the sum of the the Finger weight measurements, divided by the number of those measurements, e.g. (150 + 146 + 147 + 152 + 140 + 146) / 6 = 147.</ns1:definition>
    <rdfs:label xml:lang="en">Average finger weight - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N81269ba8edb24d33ab7d4e6b762625e0">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000335"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000320">
    <ns1:definition xml:lang="en">The number of fingers in multiple hands.</ns1:definition>
    <rdfs:label xml:lang="en">Multiple number of fingers in hand</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns2:attribute>Number of fingers</ns2:attribute>
    <ns2:acronym xml:lang="en">multnumfingshand</ns2:acronym>
  </ns3:Class>
