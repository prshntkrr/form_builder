  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010016">
    <rdfs:label xml:lang="en">Time from harvest to death - computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate as: the time elapsed between the Date of harvest of the bunch of the plant from the preceeding crop cycle and the Date of death of the current plant, e.g. 24/03/2015 - 24/12/2014 = 90 days.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf99eefc614494778bacee489fd733eda">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000296"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010354">
