    <rdfs:label xml:lang="en">hardness scale 0-10</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010211">
    <rdfs:label xml:lang="en">Damage to upper inner corm weevils - measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Cut a transverse cross section of the corm at the collar (upper cross-section). Score weevil damage (galleries) as percentage damage on the side of the cross-section that was facing the ground, downwards.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf9b3693bf87d49d78da38248678c47a2">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000650"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0000379">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns2:acronym xml:lang="en">nonharvdens</ns2:acronym>
    <rdfs:label xml:lang="en">Non-harvest density</rdfs:label>
    <ns1:definition xml:lang="en">The number of plants that are alive but not harvested (e.g. due to slow or poor development), in a defined area.</ns1:definition>
    <ns2:attribute>Combined density of plants not harvested</ns2:attribute>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0100022">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
    <rdfs:subClassOf>
