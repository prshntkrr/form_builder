  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_325:0010127">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Na4008c63ab684c0ca4062ca9469dff33">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000485"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Visually observe the shape of the curve of the fruit and choose the option that is most similar, from the 5 photos of descriptor 6.7.4. in the reference material. Observe the inner fruit in the middle of the mid-hand of the bunch. In case of an asymmetric bunch that has straight and curved fruits, please indicate it in the note section and score only the fruit on the upper side of the bunch.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf99bb2a3c2634af39c8e2030030db6a7">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_325:0000485"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Fruit shape of curve - estimation</rdfs:label>
  </ns3:Class>
