  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_339:0000150">
    <ns2:entity>Stem and Leaf</ns2:entity>
    <ns2:acronym xml:lang="en">RUSR</ns2:acronym>
    <ns2:attribute>Resistance to Rust</ns2:attribute>
    <rdfs:label xml:lang="en">Rust resistance</rdfs:label>
    <ns1:definition xml:lang="en">Degree of resistance to rust disease. Causative agent : Uromyces viciae-faba. It produces lesions on stems and leaves which result leaf fall and premature plant death</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns3:Class>
