  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000292">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Perpetual flowering method</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ndb7d5847a38f4ec1953f55a812f604ee">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000084"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe the plants and rate based on their flowering duration. Remontantcy is scored as follows: 1) flowering and fruiting only once in a season; 2) the potential to flower and fruit twice in a season, but strongly influenced by the environment; 3) flowering and fruiting twice in a season, largely irrespective of the environment; 4) flowering and fruiting multiple times, continuously in a season. Do not require decreasing day length for flower induction. In cases where stolons are observed, therefore, stolons produce flowers and fruits in the same season as the mother plant.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000254">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure the length of the pedicel of the primary fruit from the calyx to the truss.</ns1:definition>
