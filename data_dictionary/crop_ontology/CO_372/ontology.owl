    <ns1:definition xml:lang="en">The plant susceptibiltiy to crown rot caused by Colletotrichum gloeosporioides.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
