    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Growing degree days flowering method</rdfs:label>
    <ns1:definition xml:lang="en">Record the mean of daily maximum and minimum temperature, minus the base of 10 °C using appropriate weather station data beginning 1 January and accumulated throughout the year.</ns1:definition>
