      <ns3:Restriction rdf:nodeID="N5bc391c552694f8cbab66e806574062b">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000206"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Pedicel measurement method</rdfs:label>
  </ns3:Class>
