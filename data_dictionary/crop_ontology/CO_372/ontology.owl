  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000429">
    <ns1:definition xml:lang="en">Measure FRAP using freshly prepared working FRAP solution (900 μl) and adding to 100 μl of standards or extracts. Standards curves using trolox (0–0.25 mM) and ferrous sulphate (0–0.5 mM) were run with each set of extracts and were linear within these ranges. Final result was expressed as trolox equivalents (μmoles/g FW).</ns1:definition>
    <rdfs:label xml:lang="en">Ferric reducing antioxidant power trolox method</rdfs:label>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Measurement">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Method"/>
