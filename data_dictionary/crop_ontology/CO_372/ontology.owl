  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000084">
    <rdfs:label xml:lang="en">Plant bearing type</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns2:attribute>bearing type</ns2:attribute>
    <ns1:definition xml:lang="en">Evaluation to identify short-day plants that flower only in the spring when day length is less than 14 hrs, and those that continue to flower until the days begin to shorten in late summer.</ns1:definition>
    <ns2:acronym xml:lang="en">BEARINGTYPE</ns2:acronym>
    <ns2:entity>Plant</ns2:entity>
  </ns3:Class>
