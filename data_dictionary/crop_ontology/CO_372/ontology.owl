  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000428">
    <rdfs:label xml:lang="en">Ferric reducing antioxidant power FSH method</rdfs:label>
    <ns2:attribute>resistance to necrosis caused by Neopestalotiopsis sp.</ns2:attribute>
    <ns2:acronym xml:lang="en">RNEOP</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Plant resistance to necrosis caused by Neopestalotiopsis sp.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns1:definition xml:lang="en">Measure FRAP using freshly prepared working FRAP solution (900 μl) and adding to 100 μl of standards or extracts. Standards curves using trolox (0–0.25 mM) and ferrous sulphate (0–0.5 mM) were run with each set of extracts and were linear within these ranges. Final result was expressed as ferrous sulphate heptahydrate (μmoles/g fruit).</ns1:definition>
    <ns1:definition xml:lang="en">The plant resistance to necrosis caused by Neopestalotiopsis sp.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N03aee6aff1d9488b9a7915b65293c44a">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000419"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns2:entity>Plant</ns2:entity>
  </ns3:Class>
