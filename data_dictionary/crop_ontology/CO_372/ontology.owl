  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000066">
    <ns1:definition xml:lang="en">Remove frozen fruit samples the night before to fully thaw. Note the number of fruit per bag and weight to calculate average berry weight and percent drip loss. Carefully place the thawed fruit in a clamshell, separating it from the juice without squeezing the fruit, eliminating the release of excess juice or changing the fruit’s integrity. Weigh the juice. Calculate total drip loss as a percentage of fruit weight by the formula: W1-W2/W1 where W1 is the average berry weight before drip loss occurred and W2 is the average berry weight after drip loss.</ns1:definition>
    <rdfs:label xml:lang="en">Drip loss method</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N196328f33512411986bcc44fad631aef">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000065"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns3:Class>
