      <ns3:Restriction rdf:nodeID="N77fb5f643b1f491c883ae87128b7861c">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000212"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000430">
    <rdfs:label xml:lang="en">Titratable acidity NaOH method</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nbd554a4bd95a49d0b2f5f427a8a1a9ce">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000420"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure titratable acidity in 10 ml of juice diluted with distilled water (1:2 v/v) and titrated with 0.1 N NaOH, to pH 8.2, and expressed in mEq of NaOH per 100 g of fruit.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_372:0000077">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure titratable acidity of room temperature, homogenized fruit pulp samples by combining fruit and any juice lost during thawing in a zip top bag using an auto titrator with 5 grams of puree mixed with 45 ml of CO2-free water. Titrate samples with 0.1 normal NaOH to pH 8.1.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nd3a2edd7c475432cb4b8c1f2b5c0ebef">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_372:0000076"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Titratable acidity citric acid method</rdfs:label>
  </ns3:Class>
