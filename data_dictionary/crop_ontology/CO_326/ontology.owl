  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000172">
    <ns1:definition xml:lang="en">At the first visit, paint a mark on the petiole of leaf 1. Six months later, record the number of the painted leaf minus 1 and paint a mark of a different color on the new leaf 1. Repeat the operation 1 year after the first visit. The sum of the two values is the annual rate of leaf production.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N836833b47ab84960874425bad180f2ba">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000171"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:label xml:lang="en">Leaf production rate</rdfs:label>
  </ns2:Class>
