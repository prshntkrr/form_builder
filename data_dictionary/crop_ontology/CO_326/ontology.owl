  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000093">
    <ns1:definition xml:lang="en">Measure the height of 10 internodes of the stem, the measurement starting at 1.5m above the ground level, calculate mean from 30 randomly selected palms.</ns1:definition>
