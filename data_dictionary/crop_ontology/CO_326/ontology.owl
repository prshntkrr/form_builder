  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000175">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N49659eae7da3433ca31a4a3d45a3e45a">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000171"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">At the first visit, paint a mark on the petiole of leaf 1. Six months later, record the number of the painted leaf minus 1 and paint a mark of a different color on the new leaf 1. Repeat the operation 1 year after the first visit. The sum of the two values is the annual rate of leaf production. Calculate mean over 30 randomly chosen palms.</ns1:definition>
    <rdfs:label xml:lang="en">Calculate mean of leaf production rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000087">
    <ns1:definition xml:lang="en">Provide a bole category (see code) by visual assessment, to describe whether a palm has a bole or not, and bole appearance if relevant; note that no bole is typical of dwarf palms, and with bole are typical of talls and hybrids. Record the most frequent case among 30 randomly selected palms.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ndc9293919425480b942eca0bdc01f19a">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000086"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Visual assessment of bole category</rdfs:label>
  </ns2:Class>
