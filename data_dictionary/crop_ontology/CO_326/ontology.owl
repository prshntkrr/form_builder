    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns4:entity>Yield</ns4:entity>
    <ns1:definition xml:lang="en">Date of the beginning of observations</ns1:definition>
  </ns2:Class>
