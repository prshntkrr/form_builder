  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000405">
    <ns1:definition xml:lang="en">Record number of ripe nuts/palm/year measured on each harvest during 4 consecutives years. Harvest frequency is bimonthly for Talls and hybrids, monthly for Dwarfs. Perform on at least 30 palm, calculate standard deviation.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
