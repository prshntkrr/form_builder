      </rdf:Description>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Visit inflorescence daily from the moment of opening. Note dates when last female flowers and first male flowers of next inflorescence open. Record number of days betwen these dates as a positive number if last female flowers of current inflorescence come first, as a negative number if first male flowers of next inflorescence come first. Observe on 30 palms, calculate standard deviation.</ns1:definition>
    <rdfs:label xml:lang="en">Standard deviation of period between successive inflorescences</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N60afc885d6be49caa2b10cdab9e8896b">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000259"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
