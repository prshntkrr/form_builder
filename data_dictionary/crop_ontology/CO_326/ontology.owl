  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000397">
    <rdfs:label xml:lang="en">Calculate standard deviation of bunch/palm/year</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N267282cbccc2404dbff9580fce98fc88">
