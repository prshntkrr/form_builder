  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000316">
    <rdfs:label xml:lang="en">Shell weight</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/measurement"/>
    <ns1:definition xml:lang="en">During FCA: Remove meat from 3 split nuts. Weigh all half shells together. Divide total weight by the number of fruits. Perform 6 times a year during four consecutive years and record mean.</ns1:definition>
