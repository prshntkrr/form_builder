  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000320">
    <rdfs:label xml:lang="en">Calculate standard deviation of shell weight over 30 palms</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/computation"/>
    <ns1:definition xml:lang="en">During FCA: Remove meat from 3 split nuts. Weigh all half shells together. Divide total weight by the number of fruits. Perform 6 times a year during four consecutive years and record mean. Calculate mean over 30 palms. Calculate standard deviation over 30 palms.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ndc2c099c242c4d3492eba31b93d83e70">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000315"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
