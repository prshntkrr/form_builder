    <ns1:definition xml:lang="en">Count germinated nuts each day for around 16 weeks from date of sowing. Record the time until the last nut germinated</ns1:definition>
    <rdfs:label xml:lang="en">Time to max germination from sowing Counting</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000111">
    <rdfs:label xml:lang="en">Calculate mean of 2nd stem height measurement</rdfs:label>
    <ns1:definition xml:lang="en">Measure from the ground level to the base of the oldest living frond from 30 randomly selected palms, calculate mean</ns1:definition>
