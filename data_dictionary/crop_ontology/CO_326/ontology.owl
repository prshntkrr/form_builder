  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000311">
    <rdfs:label xml:lang="en">Calculate mean of split nut weight over 30 palms</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/computation"/>
    <ns1:definition xml:lang="en">During FCA: Split 3 dehusked nuts and collect (or drain) water. Weigh all half nuts together. Divide total weight by the number of fruits. Perform 6 times a year during four consecutive years and record mean. Calculate mean over 30 palms.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N512529cf7718472aa57024bb9840af6d">
