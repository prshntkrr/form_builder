    <rdfs:label xml:lang="en">Calculate standard deviation of petiole width</rdfs:label>
    <ns1:definition xml:lang="en">Measure petiole width at insertion of first leaflet on 30 randomly selected palms. Calculate standard deviation.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000318">
    <rdfs:label xml:lang="en">Calculate mean of shell weight over 30 palms</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N621ddcab0d834c3aa4714a1fb02f3c44">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000315"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">During FCA: Remove meat from 3 split nuts. Weigh all half shells together. Divide total weight by the number of fruits. Perform 6 times a year during four consecutive years and record mean. Calculate mean over 30 palms.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000458">
    <ns1:definition xml:lang="en">Accession number of female parents</ns1:definition>
    <ns4:attribute>Accession number of female parents</ns4:attribute>
    <ns4:acronym xml:lang="en">SrcPFAccNb</ns4:acronym>
    <rdfs:label xml:lang="en">Accession number of female parents</rdfs:label>
    <ns4:entity>Source population</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Collection"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000177">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N421d674dd1a04fb7bef281e7788be1c9">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000171"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Calculate standard deviation of leaf production rate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">At the first visit, paint a mark on the petiole of leaf 1. Six months later, record the number of the painted leaf minus 1 and paint a mark of a different color on the new leaf 1. Repeat the operation 1 year after the first visit. The sum of the two values is the annual rate of leaf production. Calculate standard deviation over 30 randomly chosen palms.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000379">
    <ns4:acronym xml:lang="en">YObsBDt</ns4:acronym>
