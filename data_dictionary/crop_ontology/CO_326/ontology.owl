      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Record number of bunches/palm/year measured on each harvest during 4 consecutives years. Harvest frequency is bimonthly for Talls and hybrids, monthly for Dwarfs. Perform on at least 30 palm, calculate standard deviation.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000616">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne437525a58e444edbeecdaec4d1e4488">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000615"/>
