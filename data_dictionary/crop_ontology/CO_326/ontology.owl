  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000341">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/computation"/>
    <ns1:definition xml:lang="en">During FCA: Cut approximately 100 g of solid endosperm (meat) into 1 to 2 cm pieces. Record exact fresh weight. Put sample into an oven for drying at 105°C until mass is constant (9 - 10 h). Record dry weight. Dry matter contents is 100 x dry weight /fresh weight. Calculate standard deviation over 30 palms.</ns1:definition>
    <rdfs:label xml:lang="en">Calculate standard deviation of solid endosperm dry matter content</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N128ef79393664ca2ad982a0f21039861">
