  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_326:0000057">
    <ns1:definition xml:lang="en">Maximum germination rate from date of sowing</ns1:definition>
    <ns4:attribute>Germination</ns4:attribute>
    <ns4:acronym xml:lang="en">SNutGermPct</ns4:acronym>
