      <ns2:Restriction rdf:nodeID="Nf6cb5f229a3143b2bcc45be06072d57d">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_326:0000128"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
