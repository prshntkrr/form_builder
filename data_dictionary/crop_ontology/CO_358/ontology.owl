  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000890">
    <ns1:definition xml:lang="en">Indicates degree of uniformity of plants in field plot. unif = appears uniform and each trait can be given a single score, not unif = not uniform without classification, seg = one or more traits are segregating and usually at least one trait can have multiple scores, mix = seed of another accession has germinated in the same plot, outcross = segregation is best explained by a wide cross with another accession or even a different species, volunteer = other cotton seed has germinated in place of or in competition with the accession</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">PlotHomo - Estimation</rdfs:label>
