  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000842">
    <ns4:attribute>Gossypol content</ns4:attribute>
    <ns4:acronym xml:lang="en">SGCp</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
