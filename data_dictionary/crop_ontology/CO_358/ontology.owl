    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000186">
    <rdfs:label xml:lang="en">Seed percent</rdfs:label>
    <ns1:definition xml:lang="en">Seed Percentage (SP). It is determined from ginning boll samples, and is close to being the reciprocal of lint percentage</ns1:definition>
    <ns4:attribute>Percent</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns4:acronym xml:lang="en">SP</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000080">
    <ns4:acronym xml:lang="en">SCP</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <rdfs:label xml:lang="en">Seed coat percent</rdfs:label>
    <ns4:attribute>Percent</ns4:attribute>
    <ns1:definition xml:lang="en">Weight of seed coat over weight of whole seed</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000045">
    <rdfs:label xml:lang="en">Seed vigor</rdfs:label>
    <ns4:attribute>Vigor</ns4:attribute>
    <ns1:definition xml:lang="en">The Sum total of those properties of the seed which determine the level of activity and performance of the seed or seed lot during germination and seedling emergence</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns4:acronym xml:lang="en">SDV</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000027">
