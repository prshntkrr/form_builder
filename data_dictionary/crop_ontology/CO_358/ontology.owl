  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000002">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:acronym xml:lang="en">VWDI</ns4:acronym>
    <ns4:attribute>Verticillium wilt incidence</ns4:attribute>
    <rdfs:label xml:lang="en">Verticillium wilt disease incidence</rdfs:label>
    <ns1:definition xml:lang="en">Observe incidence of verticillium wilt disease, usually recorded as the frequency of damaged individuals or their parts, commonly the portion of plant units diseased. Proportion of plants (leaves, etc.) diseased or the number diseased out of N plants (leaves, etc.) observed</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000967">
    <rdfs:label xml:lang="en">SDFZCL - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
