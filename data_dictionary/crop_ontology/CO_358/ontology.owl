    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns1:definition xml:lang="en">The total manganese (Mn) concentration measured in a given volume of a plant or a plant part or plant extract</ns1:definition>
    <ns4:attribute>Manganese concentration</ns4:attribute>
    <ns4:acronym xml:lang="en">MNCONC</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000097">
