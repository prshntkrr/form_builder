  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000965">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">DTS - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Stem hair density on the mature, expanded stem, fourth node, or older. Code description: none=hairs appear to be absent from stems; few=stem hairs are at low frequency; moderate=stem hairs are at a regular and commonly seen density for most cotton cultivars; hairy=stem hair density is greater than that normally seen on most cotton cultivars; very hairy=highest density seen on stems; pilose=stem hairs are short and may lend a soft, velvety feel to leaf surfaces</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nfffe39588e9d4f2d83ce99ae58ac1899">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000051"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
