      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">The color of the seed fuzz after ginning.  </ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000762">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">UQLW - AFIS Measurement</rdfs:label>
    <ns1:definition xml:lang="en">UQLw (mm), an AFIS measurement. It is the length which is exceeded by 25% of the fibers by weight</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N86e3ec30817f40e6b242e3b411fb4833">
