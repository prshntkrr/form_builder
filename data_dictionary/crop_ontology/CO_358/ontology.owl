  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000973">
    <ns1:definition xml:lang="en">The general shape of the mature, expanded leaves (degree of lobing ). Code descriptipn: normal=leaf shape typically seen in cotton cultivars; okra=leaf shape is more dissected; sub okra=leaf shape is intermediate between normal and okra; super okra=leaf shape is highly dissected and lobing is sometimes absent and showing single leaf; laciniate=leaf shape includes spurs at the base of the leaf; ovate=leaf shape is rounded or oval; cordate=leaf shape is like an inverted heart shape</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf31a01e83ece40229e5d968aecc74936">
