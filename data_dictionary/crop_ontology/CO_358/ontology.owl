  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000873">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9acba8229c0c466c93e5ac92584dd3c4">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000839"/>
