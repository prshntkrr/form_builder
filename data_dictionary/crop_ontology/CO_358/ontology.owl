      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000019">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns4:attribute>Iron concentration</ns4:attribute>
    <ns4:acronym xml:lang="en">FECONC</ns4:acronym>
    <ns1:definition xml:lang="en">The total Iron (Fe) concentration measured in a given volume of a plant or a plant part or plant extract</ns1:definition>
    <rdfs:label xml:lang="en">Iron concentration</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000919">
