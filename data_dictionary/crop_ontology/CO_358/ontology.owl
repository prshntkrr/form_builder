  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000917">
    <rdfs:label xml:lang="en">FWDI - Computation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne0486dd920224165ab6e51545f1dd115">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000838"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Percentage of plant survival in a field infested with Fusarium oxysporum f. sp. vasinfectum race 1 and root-knot nematodes.  The percentage of plant survival (PS) was calculated by dividing the total number of surviving plants on each sample date by the initial plant count after plant establishment, and multiplying by 100.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000010">
