  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_358:0000871">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">FWDS - Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Disease severty index of foliar symptoms in a field infested with Fusarium oxysporum f. sp. vasinfectum race 1 and root-knot nematodes.  FOV foliar disease severity Index scale: 0 = no symptoms; 1 = epinasty and slight dwarfing; 2 = 1 to 30% of leaves chlorotic; 3 = 31 to 80% of leaves chlorotic and severe stunting; 4 = 81 to 100% of leaves chlorotic; and 5 = plant death</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nfdf0bd91bbf241aa811d622e0947acf6">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_358:0000839"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
