        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/variable_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">PLWTH</rdfs:label>
    <ns3:contributor>I. M. Rao</ns3:contributor>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N3ec5759ef6bd405abf9caf2613594587">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/variable_of"/>
