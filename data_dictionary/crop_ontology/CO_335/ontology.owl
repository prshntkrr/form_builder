    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000454"/>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
