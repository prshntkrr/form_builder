    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000586"/>
    <ns1:altLabel xml:lang="en">1</ns1:altLabel>
    <rdfs:label xml:lang="en">Higher of 80 nodules</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000538/3">
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">Other (specify)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000538"/>
  </rdf:Description>
