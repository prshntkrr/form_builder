        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/variable_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000257/3">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000257"/>
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">Pink</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000245/7">
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:label xml:lang="en">Plants with petioles severely wilted, but no dead leaves throughout the canopy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000245"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000565/0">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000565"/>
    <ns1:altLabel xml:lang="en">0</ns1:altLabel>
    <rdfs:label xml:lang="en">-, Absence of gene</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000177/3">
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000177"/>
    <rdfs:label xml:lang="en">Light discoloration either without necrotic lesions or with approximately 10% of the hypocotyl and root tissues covered with lesions</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000589/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000589"/>
    <rdfs:label xml:lang="en">From 61 to 120 nodules of large size</rdfs:label>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000535/6">
    <rdfs:label xml:lang="en">Other (specify)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000535"/>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
  </rdf:Description>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000108">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6f6ae0f32a3640dfb4c44f5e7508e384">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/variable_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_335:0000351"/>
