  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000454/7">
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:label xml:lang="en">Approximately 40-60% of the evaluated unit area is infected</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000454"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000181/3">
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">Approximately 2% of the leaf surface area covered with round lesions. Very slight systemic chlorosis may be evident</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000181"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000245/6">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000245"/>
    <rdfs:label xml:lang="en">Severe wilting of leaves throughout the canopy, with advanced strong loss of petiole turgidity</rdfs:label>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000193/9">
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
    <rdfs:label xml:lang="en">Approximately 75% or more of the hypocotyl and root tissues affected with advanced stages of rotting combined with a severe reduction in the root system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000193"/>
  </rdf:Description>
