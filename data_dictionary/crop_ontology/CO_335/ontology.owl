  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000636">
    <rdfs:label xml:lang="en">Shoot biomass method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Standard protocol of biomass sampling, weigh sampled shoot biomass (leaves+stems+pods dried to constant weight at 60C) at R8 and record it.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nfab4138997c24d0f999f836046e76fe5">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
