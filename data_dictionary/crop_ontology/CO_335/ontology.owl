  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000600">
    <rdfs:label xml:lang="en">Plant flowering photoperiod response method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
