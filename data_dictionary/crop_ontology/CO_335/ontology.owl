  </ns2:Class>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000439/3">
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">Approximately 1% of the hypocotyl presents symptoms. Lower stem tissues are covered with small and superficial lesions</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000439"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000433/7">
    <rdfs:label xml:lang="en">Approximately 50% of the hypocotyl and root tissues covered with lesions combined with considerable softening, rotting, and reduction of the root system</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000433"/>
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000535/3">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000535"/>
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">Green</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000171/8">
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
    <ns1:altLabel xml:lang="en">8</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000171"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000163/7">
    <rdfs:label xml:lang="en">Presence of numerous enlarged lesions on the lower side of the leaf. Necrotic lesions can be observed on the upper leaf surface and on the petioles that cover approximately 10% of the leaf surface area</rdfs:label>
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000163"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000177/9">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000177"/>
    <rdfs:label xml:lang="en">Approximately 75% or more of the hypocotyl and root tissues affected with advanced stages of rotting combined with a severe reduction in the root system</rdfs:label>
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000433/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000433"/>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000478/7">
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:label xml:lang="en">Severe distortion of the leaves with considerable yellowing and visible honeydew on leaves</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000478"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000157/6">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000157"/>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000610/5">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000610"/>
    <rdfs:label xml:lang="en">Presence of several small to intermediate lesions with limited sporulation, that cover approximately 5% of the pod surface area</rdfs:label>
    <ns1:altLabel xml:lang="en">5</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000604/8">
    <ns1:altLabel xml:lang="en">8</ns1:altLabel>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000604"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000185/7">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000185"/>
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:label xml:lang="en">Approximately 10% of the pod surface area is affected by lesions that show a bacterial exudation on coalescing lesions that can be about 10 mm in diameter</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000177/7">
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000177"/>
    <rdfs:label xml:lang="en">Approximately 50% of the hypocotyl and root tissues covered with lesions combined with considerable softening, rotting, and reduction of the root system</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000187/2">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000187"/>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas.</rdfs:label>
    <ns1:altLabel xml:lang="en">2</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000445/9">
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000445"/>
    <rdfs:label xml:lang="en">More than 80% of the evaluated unit area is infected</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000559/1">
    <ns1:altLabel xml:lang="en">1</ns1:altLabel>
    <rdfs:label xml:lang="en">Rounded</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000559"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000163/2">
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
    <ns1:altLabel xml:lang="en">2</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000163"/>
  </rdf:Description>
