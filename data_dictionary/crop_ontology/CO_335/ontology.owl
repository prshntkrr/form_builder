    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000562"/>
    <rdfs:label xml:lang="en">Purple</rdfs:label>
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
  </rdf:Description>
