  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0001230">
    <ns1:definition xml:lang="en">Seed marketability refers to the commercial viability or attractiveness of a particular type of seed for sale in the agricultural market.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns4:attribute>Marketability </ns4:attribute>
    <ns4:entity>Grain</ns4:entity>
    <rdfs:label xml:lang="en">Marketability </rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000414">
