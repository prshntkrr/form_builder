        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_335:0000927"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure the one-sided green leaf area of plants using an area-meter, it is recommended a sample area of row length of 0.5 m for each plot.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000693">
