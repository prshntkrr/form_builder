  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000586/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000586"/>
    <rdfs:label xml:lang="en">From 21 to 40 nodules of large size</rdfs:label>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000478/3">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000478"/>
    <rdfs:label xml:lang="en">Curved leaves</rdfs:label>
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000439/7">
    <rdfs:label xml:lang="en">Approximately 25% of the hypocotyl and lower stem tissues are affected by lesions and often combined with fruiting structures of the fungus</rdfs:label>
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000439"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000253/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000253"/>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
    <rdfs:label xml:lang="en">lavender</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000763/6">
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
    <rdfs:label xml:lang="en">Total loss of leaves in the bottom of the canopy and slight loss of leaves from the middle part of the canopy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000763"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000559/4">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000559"/>
    <rdfs:label xml:lang="en">Kidney shaped</rdfs:label>
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000589/3">
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
    <rdfs:label xml:lang="en">From 121 to 240 nodules of normal or small size</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000589"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000193/4">
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000193"/>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of damage</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000187/9">
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000187"/>
    <rdfs:label xml:lang="en">Highly susceptible: presence of large and very large pustules with chlorotic halos, that cover more than 25% of the foliar tissue and cause premature defoliation</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000610/4">
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000610"/>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000523/1">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000523"/>
    <rdfs:label xml:lang="en">Upward (curved to dorsal or placental side)</rdfs:label>
    <ns1:altLabel xml:lang="en">1</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000433/5">
    <rdfs:label xml:lang="en">Approximately 25% of the hypocotyl and root tissues covered with lesions but tissues remain firm with little deterioration of the root system. Heavy discoloration symptoms may be evident.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000433"/>
    <ns1:altLabel xml:lang="en">5</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000610/9">
    <rdfs:label xml:lang="en">25% or more of the pod surface area is cover by large sporulating lesions. Infected pods are often shriveled containing a low number of seeds</rdfs:label>
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000610"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000169/4">
    <ns1:altLabel xml:lang="en">4</ns1:altLabel>
    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate stages of damage.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000169"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000161/9">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000161"/>
    <ns1:altLabel xml:lang="en">9</ns1:altLabel>
    <rdfs:label xml:lang="en">50% or more of the pod surface area is covered by large sporulating and often coalescing lesions. Infected pods are often deformed and shriveled and contain a low number of seeds.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000207/R6">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000207"/>
    <rdfs:label xml:lang="en">When 50% of the plants have the first open flower</rdfs:label>
    <ns1:altLabel xml:lang="en">R6</ns1:altLabel>
  </rdf:Description>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000024">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na04e452059d34f1ba46d54871cf25157">
