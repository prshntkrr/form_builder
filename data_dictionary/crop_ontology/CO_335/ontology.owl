    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000559"/>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000175/5">
    <rdfs:label xml:lang="en">Approximately 5% of the pod surface area covered by small and not coalescing lesions</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000175"/>
    <ns1:altLabel xml:lang="en">5</ns1:altLabel>
  </rdf:Description>
