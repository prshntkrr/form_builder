  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000957">
    <ns1:definition xml:lang="en">The rate of yield productivity.</ns1:definition>
    <ns4:acronym xml:lang="en">YDD</ns4:acronym>
    <rdfs:label xml:lang="en">Seed yield productivity rate</rdfs:label>
    <ns4:entity>Seed</ns4:entity>
    <ns4:attribute>yield productivity rate</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000657">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ndbfda05bccf348a59f659e9888f942e0">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_335:0000923"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Compute DSI for each genotype using the formula: DSI = (1 – Yds/Yns)/DII, where DII is the drought intensity index, Yds and Yns are mean yields of a given genotype in drought stress and no stress environments, respectevely.</ns1:definition>
    <rdfs:label xml:lang="en">Seed yield drought susceptibility index method</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000648">
