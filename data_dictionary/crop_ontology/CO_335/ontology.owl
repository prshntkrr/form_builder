    <ns4:acronym xml:lang="en">NSEED</ns4:acronym>
    <ns4:entity>Seed</ns4:entity>
    <rdfs:label xml:lang="en">Seed nitrogen content</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000276">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N4a80e9e44f644e8db2bc12711a5ce7e3">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_335:0000956"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Seed yield kg/ha computation method</rdfs:label>
    <ns1:definition xml:lang="en">Compute the seed yield per hectare as weight (kg) of seed harvest divided by effective plot in m2 and multiplied by 10.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000242">
    <rdfs:label xml:lang="en">Plant total root length method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
