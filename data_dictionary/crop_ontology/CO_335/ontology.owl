    <rdfs:label xml:lang="en">Unspecified intermediate values correspond to intermediate percentages of affected areas</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000207/V3">
    <rdfs:label xml:lang="en">When 50% of the plants have the first trifoliate leaf completely unfolded</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000207"/>
    <ns1:altLabel xml:lang="en">V3</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000171/7">
    <rdfs:label xml:lang="en">Approximately 10% of the leaf surface area covered with medium and large lesions which are usually accompanied by yellow halos and necrosis</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000171"/>
    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
  </rdf:Description>
