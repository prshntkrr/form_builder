    <rdfs:label xml:lang="en">1-9 Effective nodules number in climbing bean scale</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_335:0000567">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na13bdcb0bd514db295ca7ac3737ebf5b">
