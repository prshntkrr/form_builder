    <ns1:altLabel xml:lang="en">7</ns1:altLabel>
    <rdfs:label xml:lang="en">Abundant and large sporulating lesions that cover approximately 10% of the leaf surface area. The lesions may coalesce</rdfs:label>
  </rdf:Description>
