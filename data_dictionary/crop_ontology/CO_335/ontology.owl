  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000171/5">
    <rdfs:label xml:lang="en">Approximately 5% of the leaf surface area covered by small lesions that are beginning to coalesce and sometimes encircled by yellow halos resulting in minor blight</rdfs:label>
    <ns1:altLabel xml:lang="en">5</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000171"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000245/5">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000245"/>
    <ns1:altLabel xml:lang="en">5</ns1:altLabel>
    <rdfs:label xml:lang="en">Moderate wilting of leaves throughout the canopy, and moderate loss of petiole turgidity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_335:0000245/3">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_335:0000245"/>
    <rdfs:label xml:lang="en">Moderate wilting evidenced by leaf wilting and rolling throughout the canopy</rdfs:label>
    <ns1:altLabel xml:lang="en">3</ns1:altLabel>
  </rdf:Description>
