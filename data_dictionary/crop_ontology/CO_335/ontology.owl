        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_335:0000952"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Seed harvest index method</rdfs:label>
    <ns1:definition xml:lang="en">Compute using the formula HI = seed biomass (yield) DW at harvest / total shoot biomass DW at mid-podfilling x 100</ns1:definition>
  </ns2:Class>
