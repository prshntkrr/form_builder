    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Visually compare the shape of ligules with a diagram or photographs representing the standard shape classes for cultivated rice</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Ligule shape determination - cultivated</rdfs:label>
