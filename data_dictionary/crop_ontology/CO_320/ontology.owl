        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Estimate the % leaf area diseased in a greenhouse test</ns1:definition>
    <rdfs:label xml:lang="en">Bacterial blight damage estimation greenhouse</rdfs:label>
  </ns2:Class>
