    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001171">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculate the ratio of total aerenchyma area to cortex area</ns1:definition>
    <rdfs:label xml:lang="en">Calculation - Specific culm porosity</rdfs:label>
    <rdfs:subClassOf>
