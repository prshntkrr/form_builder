  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001193">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:label xml:lang="en">Calculation - Grain yield from components of yield</rdfs:label>
