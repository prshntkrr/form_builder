  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000798">
    <rdfs:label xml:lang="en">Rice delphacid injury assessment field</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Observe the damages on plants caused by rice delphacid. For a field test, use an augmented experimental design with a susceptible check replicated at intervals across the whole trial. The test is considered a valid test for resistance if the hopper population is uniformly distributed at a high level across the screening box, as indicated by hopper counts on the susceptible check. A minimum of the following hopper density on susceptible check is necessary: a. 10 hoppers/hill at 10-15 days after transplanting, b. 25 hoppers / hiII at maximum tillering, c. 100 hoppers/hill at early booting stage</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nfd8ce782df1041068a1f070d47782771">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000216"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000776">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Ligule margin shape determination</rdfs:label>
    <ns1:definition xml:lang="en">Visually compare the shape of ligules with a diagram or photographs representing the standard shape classes for wild rice</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N63b224d2906e45e49b9f783b9bb43f5f">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000507"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
