        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Tillers per m2</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000076">
    <rdfs:label xml:lang="en">Plant height</rdfs:label>
    <ns4:entity>Plant</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns1:definition xml:lang="en">Plant height defined as distance from the soil surface to the highest point of the plant (panicle or flag leaf) excluding awns</ns1:definition>
    <ns4:acronym xml:lang="en">PlntHt</ns4:acronym>
    <ns4:attribute>Height</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000931">
    <rdfs:label xml:lang="en">bacterial blight race 1 damage scale field</rdfs:label>
    <rdfs:subClassOf>
