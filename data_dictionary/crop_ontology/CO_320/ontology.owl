  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001158">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6edb14c8307d427781505777ac0842ac">
