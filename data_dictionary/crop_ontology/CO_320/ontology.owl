        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000193"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Estimate the proportion of young plants with leaves showing symptoms</ns1:definition>
  </ns2:Class>
