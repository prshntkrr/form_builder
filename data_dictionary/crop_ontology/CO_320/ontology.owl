  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000544">
    <rdfs:label xml:lang="en">Glume opening angle</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N51e4fefe43e34a01aa8cc6dd68984076">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000094"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Collect 5-10 blooming florets of a male sterile line from different plants and measure the average angle of the opening between glumes (viz., lemma and palea)</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N7cfe3c021c484b3385bba28f3702cb79">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000094"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001097">
    <ns4:attribute>Number per area</ns4:attribute>
    <ns4:entity>Filled spikelet</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <rdfs:label xml:lang="en">Filled spikelet density</rdfs:label>
    <ns4:acronym xml:lang="en">FSD</ns4:acronym>
    <ns1:definition xml:lang="en">Number of spikelets with filled grains per unit area</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000260">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N063bb23fe1c84a9188252939086ec8e8">
