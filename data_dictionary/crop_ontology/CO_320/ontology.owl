        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000208"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">At maximum tillering, observe the proportion of tillers that have stems with deadheart. Use an augmented experimental design with a susceptible check replicated at intervals across the whole trial. Dissect stems from 10 hills of susceptible checks at maximum tillering, panicle initiation and late ripening, in order to identify the SB species. The test is considered a valid test for resistance if the susceptible check has more than 20% of tillers with deadheart</ns1:definition>
    <rdfs:label xml:lang="en">Stem borer deadheart damage assessment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
