  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000548">
    <rdfs:label xml:lang="en">Coleoptile anthocyanin evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1d45766b10d844e6bb0f63ff2ad64508">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000146"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf22ec0b9f905459e9b7e5ef81a20a361">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000491"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Place non-dormant grains on moistened filter paper and cover with a petri-dish lid during germination. After the coleoptiles have reached a length of about 5 mm in darkness, place them in artificial light (daylight equivalent) at 750-1250 lux continuously for 3 to 4 days, at a temperature of 25 to 30 degrees Centigrade. Observe colour when the coleoptile is fully with first leaf just emerging (about 6 to 7 days)</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000146">
    <rdfs:label xml:lang="en">Awn length</rdfs:label>
