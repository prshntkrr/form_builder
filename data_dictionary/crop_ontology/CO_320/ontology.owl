    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Image analysis - Culm wall thickness</rdfs:label>
    <ns1:definition xml:lang="en">View cross-sectioned sample of second internode under stereo microscope and use Image J software to measure the thickness of the wall of the cross-sectioned culm</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000284">
    <rdfs:label xml:lang="en">Rhizome formation observation</rdfs:label>
