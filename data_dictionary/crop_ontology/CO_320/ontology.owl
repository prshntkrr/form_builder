  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000471">
    <ns1:definition xml:lang="en">Dehull and mill (polish) a sample of grains (paddy). Weigh the whole sample of polished rice, including both whole and broken kernels. Measure the length of 10 randomly selected whole kernels and compute the average. Head rice are all the kernels longer than 8/10th of the average length of whole kernels. Separate and weigh the head rice, and calculate the proportion of head rice out of the total weight of polished rice</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2231e1cfed2e4fc4bae28ed3d8151cde">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000108"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Head rice proportion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001239">
