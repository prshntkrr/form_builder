    <ns4:entity>Gall midge</ns4:entity>
    <ns4:acronym xml:lang="en">GallMidgeDam</ns4:acronym>
    <ns1:definition xml:lang="en">The extent of plant damage caused by gall midge (Orseolia oryzae). Symptoms: light-colored tubular galls resembling an onion leaf on the youngest leaf of the shoot in a tiller.</ns1:definition>
