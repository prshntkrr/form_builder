    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Image analysis - Stem aerenchyma diameter</rdfs:label>
    <ns1:definition xml:lang="en">View cross-sectioned samples of second internode under stereo microscope and use Image J software to measure the diameter of the air space in the culm</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000408">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N867d8841b38c455ea9af554f6d491316">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000067"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Submergence survival assessment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Field evaluation: estimate the proportion of plants that survive submergence after floodwater recedes. Record the duration of submergence</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000578">
    <rdfs:label xml:lang="en">leaf blade pubescence scale wild</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:subClassOf>
