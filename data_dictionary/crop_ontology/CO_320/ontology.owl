  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000457">
    <rdfs:label xml:lang="en">Peak temperature</rdfs:label>
    <ns1:definition xml:lang="en">Gradually heat a sample of milled rice using a Differential Scanning Calorimeter (DSC), which measures the energy expended to raise the temperature of starch crystals as they gelatinize and melt. The temperature at which energy expenditure is maximum (peak temperature) provides a precise measure of gelatinization temperature.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nd4919a6528894b3b8f58aab5a4c38c95">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000107"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
