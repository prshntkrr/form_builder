    <rdfs:label xml:lang="en">Filled spikelet proportion</rdfs:label>
    <ns4:acronym xml:lang="en">FSpProp</ns4:acronym>
    <ns1:definition xml:lang="en">Proportion of spikelets on a harvested panicle that contain filled grains</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000369">
    <rdfs:subClassOf>
