    <rdfs:label xml:lang="en">Average - Stem dry weight</rdfs:label>
    <ns1:definition xml:lang="en">Oven dry representative stems at 70degC to constant weight. Weigh and take the average stem weight</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc2e7fa6890e14df9ab87ebc5ae3a70ba">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
