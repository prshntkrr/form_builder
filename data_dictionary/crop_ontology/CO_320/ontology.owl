  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000340">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Assess the type of lesion and the proportion of leaf area affected by leaf blast. Entries with scores 4-9 may also have lesions of scale 1 or 2. In cases where the lesion develops only on the collar, joint of the leaf sheath and the leaf blade, causing the leaf blade to drop off, a scale unit of 4 is to be given.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N328ca03fcee54118a3a6d1435828bef6">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000176"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Leaf blast damage estimation</rdfs:label>
  </ns2:Class>
