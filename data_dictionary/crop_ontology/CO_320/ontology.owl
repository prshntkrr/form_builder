        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000039"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
