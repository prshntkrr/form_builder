  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001263">
    <rdfs:label xml:lang="en">Calculation - Half-filled spikelet percentage</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1bf2f7df2047431e8ccdb3f023c54a03">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001137"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Take the number of half-filled spikelets (per square meter or per panicle) and divide by the total number of spikelets (per square meter or per panicle) and multiply by 100</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
