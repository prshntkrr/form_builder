      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Sow plants in an enclosed cage or greenhouse with a uniform high population of biotype 2 of brown planthopper, and observe the damage on the seedlings</ns1:definition>
  </ns2:Class>
