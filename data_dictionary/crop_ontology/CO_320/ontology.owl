    <rdfs:label xml:lang="en">Stem rot</rdfs:label>
    <ns4:acronym xml:lang="en">StmRotInc</ns4:acronym>
    <ns1:definition xml:lang="en">The type and severity of stem rot symptoms caused by Magnaporthe salvinii (Nakatea sigmoidea, Sclerotium oryzae) and Helminthosporium sigmoideum var. irregulare. Symptoms: dark lesions develop on the stems near the water line. Small, dark bodies (sclerotia) develop, weaken the stem and cause lodging.</ns1:definition>
    <ns4:entity>Stem rot</ns4:entity>
  </ns2:Class>
