    <rdfs:label xml:lang="en">Culm length</rdfs:label>
    <ns1:definition xml:lang="en">Length of the main culm (stem), defined as the distance from the soil surface to the base of the panicle</ns1:definition>
    <ns4:acronym xml:lang="en">CulmLng</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
