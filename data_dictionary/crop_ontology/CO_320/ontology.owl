  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000489">
    <ns4:acronym xml:lang="en">BLSAnth</ns4:acronym>
    <rdfs:label xml:lang="en">Basal leaf sheath anthocyanin</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
