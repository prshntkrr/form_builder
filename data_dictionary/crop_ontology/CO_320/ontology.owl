    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
    <rdfs:label xml:lang="en">flag leaf angle scale cult early</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Naa6c2aced84b4d1eba13bf710267882c">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000274"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
