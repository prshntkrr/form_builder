    <ns1:definition xml:lang="en">The extent to which plant growth is adversely affected by a deficiency of zinc in the growing medium</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Abiotic_stress"/>
    <ns4:entity>Zinc deficiency</ns4:entity>
    <ns4:acronym xml:lang="en">ZnDefInj</ns4:acronym>
