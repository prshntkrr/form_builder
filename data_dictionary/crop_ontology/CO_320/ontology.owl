        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000525">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc13098bc6e144a41b44217686b2276eb">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000036"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1ff766bc2f23465a8a958d3d097d85f3">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000036"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Examine the colour of the awns after harvest against a colour chart or colour-accurate photographs of references.</ns1:definition>
    <rdfs:label xml:lang="en">Awn color examination mature UPOV / IRRI</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001100">
    <ns1:definition xml:lang="en">Total number of spikelets per panicle</ns1:definition>
    <ns4:entity>Spikelet</ns4:entity>
    <ns4:acronym xml:lang="en">SpPan</ns4:acronym>
    <rdfs:label xml:lang="en">Spikelets per panicle</rdfs:label>
    <ns4:attribute>Number per panicle</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000770">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N36dce3cfff7b43e5953149a2f789da12">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000201"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Leaffolder single leaf injury assessment</rdfs:label>
    <ns1:definition xml:lang="en">In a greenhouse test, observe the early injury from leaffolder to each leaf on young plants</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000173">
    <ns4:entity>Bacterial blight</ns4:entity>
    <rdfs:label xml:lang="en">Bacterial blight damage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:acronym xml:lang="en">BBDam</ns4:acronym>
    <ns4:attribute>Damage</ns4:attribute>
    <ns1:definition xml:lang="en">The type and severity of bacterial blight symptoms on leaves caused by the bacterial pathogen Xanthomonas oryzae pv. oryzae. Symptoms: lesions usually start near the leaf tip or leaf margins or both, and extend down the outer edge(s). Young lesions are pale green to grayish green, later turning yellow to gray (dead) with time. In very susceptible varieties, lesions may extend to the entire leaf length into the leaf sheath</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000200">
    <ns4:entity>Green leafhopper</ns4:entity>
    <rdfs:label xml:lang="en">Green leafhopper damage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:acronym xml:lang="en">GLhDam</ns4:acronym>
    <ns1:definition xml:lang="en">The extent of damage caused by green leafhopper (Nephotettix virescens and Nephotettix cincticeps). Symptoms: partial to pronounced yellowing and increasing severity of stunting. Extreme signs are wilting to death of plants. Infested areas in the field may be patchy.</ns1:definition>
    <ns4:attribute>Damage</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000522">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N59f72bccf3364844985dc54e2f08afd1">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000037"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Mature apiculus color examination</rdfs:label>
    <ns1:definition xml:lang="en">Examine the colour of the apiculus of maturing lemmas against a colour chart or colour-accurate photographs of references</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5d0a90bb3ab640618b5687638d612978">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000037"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000177">
    <rdfs:label xml:lang="en">Brown spot damage</rdfs:label>
    <ns1:definition xml:lang="en">The type and severity of brown spot symptoms on leaves caused by the fungal pathogen Cochliobolus miyabeanus (Bipolaris oryzae, Drechslera oryzae). Symptoms: typical leaf spots are small, oval or circular and dark brown. Larger lesions usually have the same color on the edges but have a pale, usually grayish center. Most spots have a light yellow halo around the outer edge.</ns1:definition>
    <ns4:acronym xml:lang="en">BS</ns4:acronym>
    <ns4:entity>Brown spot</ns4:entity>
    <ns4:attribute>Damage</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001054">
    <ns4:entity>Spikelet</ns4:entity>
    <ns1:definition xml:lang="en">Amount of grain (weight) produced per one plant</ns1:definition>
    <ns4:acronym xml:lang="en">GYplt</ns4:acronym>
    <ns4:attribute>Weight per plant</ns4:attribute>
    <rdfs:label xml:lang="en">Grain yield per plant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001287">
    <rdfs:label xml:lang="en">Average - Panicle temperature</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf795ce539a094485b31962f36f6410dc">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001055"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Take representative panicles, measure temperature near panicle surface with an infrared gun and take the average</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000574">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2f18837a638244c4b6a6a57aac71213c">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000762"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
