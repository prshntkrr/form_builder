  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001173">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne4f4cedb81ad4c3b815c4a7f68337c81">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
