    </rdfs:subClassOf>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000201">
    <ns4:acronym xml:lang="en">LfFolderDam</ns4:acronym>
    <rdfs:label xml:lang="en">Leaffolder damage</rdfs:label>
    <ns1:definition xml:lang="en">The extent of leaf damage caused by leaffolder (Cnaphalocrosis medinalis or Marasmia patnalis). Symptoms: Larvae consume the leaf tissue except the epidermis, causing typical white streaks. They create a leaf tube during later stages of feeding</ns1:definition>
    <ns4:attribute>Damage</ns4:attribute>
    <ns4:entity>Leaffolder</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000206">
    <ns1:definition xml:lang="en">The extent of plant damage caused by rice whorl maggot (Hydrellia philippina). Symptoms: maggots eat the leaf margins causing conspicuous injury and sometimes stunting of plants</ns1:definition>
    <ns4:entity>Rice whorl maggot</ns4:entity>
    <rdfs:label xml:lang="en">Rice whorl maggot damage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <ns4:acronym xml:lang="en">RWhorlMaggDam</ns4:acronym>
    <ns4:attribute>Damage</ns4:attribute>
  </ns2:Class>
