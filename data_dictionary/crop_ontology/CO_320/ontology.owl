  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000370">
    <rdfs:label xml:lang="en">Brown planthopper injury assessment greenhouse</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6c0104221a3f4fbc94fddc35419abfef">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000196"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Sow plants in a greenhouse with a uniform high population of brown planthoppers and observe the damage on the seedlings</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
