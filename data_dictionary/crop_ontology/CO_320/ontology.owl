        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001241"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">millimeter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001183">
    <rdfs:label xml:lang="en">Average - Pooled oven dry weight</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N03a5f4308ec8457d82bdfe1527e30b42">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001077"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Pool representative flag leaves and leaves below the flag leaf and oven dry at 70degC to constant weight and then weigh. Take the average</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001557">
    <rdfs:label xml:lang="en">chalkiness 0-5 scale</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nb5dddad658fa4d65afc407dac0178bef">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000428"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Ordinal"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000264">
    <ns1:definition xml:lang="en">Cultivated species: visually estimate the colour of ligules at late vegetative stage before flowering.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N724c05a107344b02a260f659eac2003c">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000026"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">Ligule color estimation - cultivated</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000004">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <ns4:attribute>Length</ns4:attribute>
    <rdfs:label xml:lang="en">Grain length</rdfs:label>
    <ns4:entity>Spikelet</ns4:entity>
    <ns4:acronym xml:lang="en">GrLng</ns4:acronym>
    <ns1:definition xml:lang="en">Length of whole grain including the hull, defined as the distance from the base of the lowermost sterile lemma to the tip (apiculus) of the fertile lemma or palea</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001390">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nc7688bfbb01b42e19d4a488d76250c92">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0001256"/>
