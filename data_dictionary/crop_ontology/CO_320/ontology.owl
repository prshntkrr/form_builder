  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000514">
    <ns4:acronym xml:lang="en">SdDate</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns4:attribute>seeding date</ns4:attribute>
    <rdfs:label xml:lang="en">Seeding date</rdfs:label>
    <ns1:definition xml:lang="en">Date of effective seeding, ie the date when seeds were first moistened This may be the date of soaking for pre-soaked seed, or the date of sowing for dry seed sown onto a wet seedbed, or the date when rain or other moisture becomes available to seed sown dry on a dry seedbed</ns1:definition>
    <ns4:entity>Plant</ns4:entity>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000244">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6db9e20b8148441c98e8dd1be082c5c7">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000106"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Place 0.1g ground rice in a test tube with thymol blue (0.025% in ethanol, 0.2 ml) and KOH (0.2N, 2 ml). Shake the tube to mix contents, boil (8 min), rest (5 min) and then place in an ice-bath (15 min). Lay cooled tubes flat on graph paper for 1 hour, and then measure the distance that the gel travels . Included standards, as the age of the rice, degree of milling and operator skill affect reproducibility: IR48 (85?90 mm), IR32 (72-75 mm) and IR42 (30-32 mm).</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N48cdfa2ef43f4927bd8c2135a5f19d57">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000106"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Gel consistency lab measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000596">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Numerical"/>
    <rdfs:subClassOf>
