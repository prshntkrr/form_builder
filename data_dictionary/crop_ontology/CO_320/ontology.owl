        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000895"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Examine the colour of the area just below the apiculus of immature lemmas and estimate the intensity of any purple colour attributable to anthocyanin</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000793">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N10885550cb064f13ab19970866a08d2c">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_320:0000158"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Male sterility estimation</rdfs:label>
    <ns1:definition xml:lang="en">Examine pollen grains under a microscrope and estimate the proportion that are sterile</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0000573">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N6652cda109fa4499a9260807b3cb1b75">
