      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Panicle threshability estimation RD</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_320:0001210">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Take the number of filled spikelets and divide by the total number of spikelets per panicle, multiply by 100</ns1:definition>
