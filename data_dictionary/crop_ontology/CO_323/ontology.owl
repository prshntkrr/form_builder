        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_323:0000102"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measure awns from the tip of the spike up to the tip of the awns.</ns1:definition>
    <rdfs:label xml:lang="en">Awn length - Measurement</rdfs:label>
  </ns2:Class>
