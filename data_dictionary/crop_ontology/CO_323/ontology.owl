  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000292">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N535bee5c395e4681bcf67e5ffaa7977a">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_323:0000291"/>
