  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000275">
    <rdfs:label xml:lang="en">Rust coefficient of infection - Computation</rdfs:label>
    <ns1:definition xml:lang="en">Compute Rust coefficient of infection (CI) by multiplying the severity times a constant for host response: where immune = 0.0, R=0.2, MR =0.4, MS =0.8, and S=1.0.</ns1:definition>
