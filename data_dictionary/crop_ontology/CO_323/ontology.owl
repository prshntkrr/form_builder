  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000388">
    <ns1:definition xml:lang="en">The amount in adjusted weight basis (at commercial/standard moisture content) of grain that was harvested per unit area or plant.</ns1:definition>
