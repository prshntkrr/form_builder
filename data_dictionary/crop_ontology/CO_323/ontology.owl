        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_323:0000096"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
