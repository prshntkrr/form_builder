  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000517">
    <rdfs:label xml:lang="en">Smuts incidence - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N991d976126334765983972d534bb280f">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_323:0000150"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observe incidence of Smuts, usually recorded as the frequency of damaged individuals or their parts, commonly the portion of plant units diseased. Proportion of plants (or spikes) diseased or the number diseased out of N plants (or spikes) observed.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000259">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N69bb9792bb4446b987c14ded1591d5c8">
