  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_323:0000171">
    <ns1:definition xml:lang="en">The plant susceptibility to aphids in general, without distinguishing species. For example, Corn leaf aphid (Rhopalosiphum maidis), Russian wheat aphid (Diuraphis noxia), Greenbug (Schizaphis graminum), etc.</ns1:definition>
