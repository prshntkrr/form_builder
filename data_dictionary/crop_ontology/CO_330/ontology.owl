    <rdfs:label xml:lang="en">Canopy reflectance</rdfs:label>
    <ns2:entity>Canopy</ns2:entity>
    <ns1:definition xml:lang="en">Reflectance indices are calculated from the visible and near-infrared light reflected by vegetation to estimate biomass and changes in leaf water content.</ns1:definition>
    <ns2:acronym xml:lang="en">CnpRfl</ns2:acronym>
    <ns2:attribute>reflectance</ns2:attribute>
  </ns3:Class>
