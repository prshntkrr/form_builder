    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">Summer Number of plants with leaves stinged by beet leaf bug - evaluated on 4 * 5 continuous plants - counted every week between ground cover and summer end</ns1:definition>
  </ns2:Class>
