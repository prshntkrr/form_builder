  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_333:3000034/6">
    <rdfs:label xml:lang="en">Up to 50% of plants with totally yellow leaves - 40-60% of leaf area yellow (Yellowing 40%)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_333:3000034"/>
    <ns1:altLabel xml:lang="en">6</ns1:altLabel>
