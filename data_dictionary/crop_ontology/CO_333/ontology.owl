    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">SPNBPLSYSTNEM method</rdfs:label>
    <ns1:definition xml:lang="en">Spring / Emergence Number of plant with stem nematode symptoms (bites, cuts, perforations) on 4 * 5 continuous plants - counted each week between stage 2 cotyledon and stage 8 leaves</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
  </ns2:Class>
