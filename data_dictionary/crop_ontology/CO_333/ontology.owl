    <rdfs:label xml:lang="en">SPNBPLTOCF method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">Spring / Emergence Number of plant destructed by or with crane-fly symptoms (bites, cuts, perforations) on 4 * 5 continuous plants - counted each week between stage 2 cotyledon and stage 8 leaves - must be sum of SPNBPLDESCF and SPNBPLSYCF</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_333:2000110">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
