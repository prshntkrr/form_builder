    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Cassava anthracnose stem lesion severity is scored at different times after planting to coincide with typically high symptom expression.  Symptoms are rated on a scale from 1 (= no symptoms) to 5 (= extremely severe stem lesions and dieback of stem)</ns1:definition>
  </ns3:Class>
