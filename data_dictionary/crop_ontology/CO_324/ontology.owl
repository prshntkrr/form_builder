        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Photoperiod sensitivity coefficient P2R - Computation</rdfs:label>
  </ns2:Class>
