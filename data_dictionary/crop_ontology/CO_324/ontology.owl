        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_324:0000999"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Dry matter content of the Whole Above-ground Biomass (WAB) - Computation</rdfs:label>
  </ns2:Class>
