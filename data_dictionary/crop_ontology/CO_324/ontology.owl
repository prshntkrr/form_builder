  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_324:0000700">
    <ns1:definition xml:lang="en">Compute the number of degree days (Thermal time) from emergence to ligulation of the flag leaf. Thermal time from  emergence to the ligulation of the flag leaf was computed using an algorithm developed by Jones and Kiniry (1986), considering that growth speed increases as a linear function of temperature between a base and an optimal temperature, and then decreases linearly between optimal and maximal temperature. Cardinal temperatures were 11∞C for base temperature (Tb) (Lafarge and Hammer, 2002), 34∞C for optimum temperature (Topt) and 44∞C for maximum temperature (Tmax) (Abdulai et al., 2012).</ns1:definition>
    <rdfs:label xml:lang="en">Thermal Time from emergence to flag leaf ligulation - computation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N3b9be2a516324999b3f6c2dc2eb49061">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_324:0000274"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
