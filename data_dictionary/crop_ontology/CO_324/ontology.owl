      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Compute the stem volume as the sum of the individual volume of each internode along the stem using internode length and diameter and assuming that internodes are cylinders</ns1:definition>
  </ns2:Class>
