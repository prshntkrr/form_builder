    <rdfs:label xml:lang="en">Van Soest method using NIRS calibration for cellulose determination in the NDF - Computation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N5681c3a07e8341969cda7f6ad6b9da1a">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_324:0000734"/>
