  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_324:0000705">
    <ns4:acronym xml:lang="en">P2R</ns4:acronym>
    <ns4:attribute>Photoperiod-sensitivity-coefficient-CERES</ns4:attribute>
    <rdfs:label xml:lang="en">Photoperiod sensitivity coefficient of the variety based on CERES model</rdfs:label>
    <ns4:entity>Panicle</ns4:entity>
    <ns1:definition xml:lang="en">CERES model considers that, above criticial photoperiod (P2O), a linear growth of the duration of the vegetative phase (in degree days) as a function of photoperiod. The slope of this line (P2R) defines photoperiod-sensitivity.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
  </ns2:Class>
