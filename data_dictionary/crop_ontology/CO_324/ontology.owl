  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_324:0000706">
    <ns1:definition xml:lang="en">The P2R respresents the photoperiod sensitivity computed according to the CERES model. CERES model considers that, above criticial photoperiod (P2O), a linear growth of the duration of the vegetative phase (in degree days) as a function of photoperiod. The slope of this line (P2R) defines photoperiod-sensitivity.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N435ce982609f4d06a3287a783fe8473d">
