  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_324:0001000">
    <ns1:definition xml:lang="en">Calculate the dry matter of the whole above-ground biomass based on the ratio of the sums of the fresh and dry weights of the different organs (stem, leaves and panicle of the main shoot)</ns1:definition>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Computation">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Method"/>
