    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns4:acronym xml:lang="en">GlmAwn</ns4:acronym>
    <rdfs:label xml:lang="en">Glume awnedness</rdfs:label>
  </ns2:Class>
