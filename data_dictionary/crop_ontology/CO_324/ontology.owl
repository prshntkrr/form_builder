  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_324:0000994">
    <rdfs:label xml:lang="en">Stem volume calculation - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
