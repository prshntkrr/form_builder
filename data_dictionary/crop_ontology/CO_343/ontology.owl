  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_343:0100223">
    <ns1:definition xml:lang="en">Averaged crop vigor expressed in days from median emergence to 80% of maximum ground cover in subplots.
Ground cover computed from weekly images analysis. 
Time at 80% of maximum growth computed via inverse regression of time to event Beta ground cover dynamic model. </ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ne6edebbc3f484c29a6ff49f07e702167">
