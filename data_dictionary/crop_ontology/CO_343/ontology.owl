      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Small size yam fresh weight per plant-computation</rdfs:label>
    <ns1:definition xml:lang="en">Compute by dividing fresh weight measurement of small size tubers taken to the number of harvested plants in a net plot</ns1:definition>
  </ns2:Class>
