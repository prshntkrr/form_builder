  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_343:0010118">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nd3b91134d7964ff5b4a3047ed27fdbdf">
