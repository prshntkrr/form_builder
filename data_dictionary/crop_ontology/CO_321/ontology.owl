        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Image Analysis Screen Mass6</rdfs:label>
    <ns1:definition xml:lang="en">Measurement of grain size distribution based on the percent mass of the grains that are below 1.6 mm based on screenings using the Seed Count (SC5000R) machine.</ns1:definition>
  </ns2:Class>
