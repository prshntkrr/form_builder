  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000199">
    <ns1:definition xml:lang="en">Normalized water index 2 is used track changes in rwc, leaf water potential, stomatal conductance, and foliage minus air temperature differences when plant water stress is well developed (rwc&lt;0.85).</ns1:definition>
    <ns4:attribute>Normalized water index 2</ns4:attribute>
    <ns4:entity>Canopy</ns4:entity>
    <ns4:acronym xml:lang="en">NWI2</ns4:acronym>
