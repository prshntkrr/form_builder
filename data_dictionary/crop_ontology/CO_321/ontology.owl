        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000240"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">mmol/m2/s</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000689">
