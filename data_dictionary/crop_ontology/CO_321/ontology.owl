    <ns4:acronym xml:lang="en">SIPI</ns4:acronym>
    <ns1:definition xml:lang="en">Structural independent pigment index uses wavelengths showing the best semi-empirical estimation of the carotenoid chlorophyll a ratio (car:chla ratio), and its formulation minimizes the disrupting effects of leaf surface and mesophyll structure.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
