    <rdfs:label xml:lang="en">Canopy normalized water index 2</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000362">
    <rdfs:label xml:lang="en">LAI Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">LAI can be determined directly by taking a sample of canopy from a plant canopy, measuring the leaf area per sample plot with an area meter or image scanner and dividing it by the plot land surface area. Indirect methods use ceptometer to measure canopy geometry or light extinction and relate it to LAI. (LAI = leaf area / ground area, m2 / m2).</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1f2232756850411793ad1e0b69070f84">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000184"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
