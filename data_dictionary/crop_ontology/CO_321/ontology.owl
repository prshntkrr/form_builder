  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000350">
    <ns1:definition xml:lang="en">Above-ground symptoms of root lesion nematodes are often indistinct and difficult to identify, but include poor vigor, stunted growth, poor tillering, and wilting in response to moisture stress. Often, crop growth in an infected field will be irregular or patchy. Below ground, cereal roots will display generalized root browning, with lesions rapidly coalescing to produce extensive areas of discoloration. Lesions are only readily observed on the roots in the very early stages of infection. Lateral roots will be reduced in both length and number, and the root system may be thin and poorly branched or appear necrotic.</ns1:definition>
    <rdfs:label xml:lang="en">RLNDmg Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N2b212dcafc9542c8a5cf556e681407d2">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000161"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
