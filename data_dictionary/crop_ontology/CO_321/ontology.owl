      <ns2:Restriction rdf:nodeID="Nce1bccac30604426a6eb4861d2616bbb">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000153"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
