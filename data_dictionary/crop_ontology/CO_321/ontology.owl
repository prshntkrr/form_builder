  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000842">
    <rdfs:label xml:lang="en">Mat DS87 date Estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na465ed8942c149d7b69ca234ff70f161">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
