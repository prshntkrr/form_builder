    <ns1:definition xml:lang="en">Number of days required from sowing to when 50% of spikes have flowered (DS65). However, when planting in dry soils in dryland areas it is counted from the first day of rainfall or irrigation which is sufficient for germination, or from emergence date.</ns1:definition>
    <rdfs:label xml:lang="en">Ant DS65 DT Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
