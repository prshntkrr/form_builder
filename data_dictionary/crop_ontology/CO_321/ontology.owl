        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000210"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N7eef0d3e6c6648d68942364d08261a01">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000145"/>
