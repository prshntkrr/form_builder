      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Record date of physiological maturity (approx. DS87). It is estimated as when the grain reaches the maximum dry weight and the grain becomes viable. It is most easily determined in-field when 50% of the peduncles are ripe (i.e., yellow).</ns1:definition>
  </ns2:Class>
