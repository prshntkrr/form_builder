      <ns2:Restriction rdf:nodeID="N2ca97763495748b5a9aca61190290878">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000909"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">PstriSpkSev Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000694">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N1e2ed25238fd461890a6e07069a739eb">
