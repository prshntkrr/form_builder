    <ns4:acronym xml:lang="en">BMNUpE</ns4:acronym>
    <ns1:definition xml:lang="en">N-uptake efficiency as the total amount of Nitrogen in the above-ground plant at harvest in relation to the available Nitrogen in soil.</ns1:definition>
    <rdfs:label xml:lang="en">Nitrogen uptake efficiency</rdfs:label>
    <ns4:entity>Plant</ns4:entity>
  </ns2:Class>
