        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000228"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">1. A sample of 35 grams of flour on a 14 percent moisture basis is weighed and placed in a mixograph bowl, 2. Water is added to the flour from a buret and the bowl is inserted into the mixograph, 3. The flour and water are mixed together to form a dough, 4. As the dough is mixed, the mixograph records a curve on graph paper.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">MIXOGRAPH determination AACC 54-40 A</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N8ccfa2ef59e8481e95043f328983eec2">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000149"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
