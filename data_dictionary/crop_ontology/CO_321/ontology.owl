  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000344">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9f0bf8c91d26416cb0c55b7bb462f632">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000132"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">SaltTol  Estimation</rdfs:label>
    <ns1:definition xml:lang="en">Observe the growth of plants per plot/entry at the field presenting soil salinity and rate the tolerance.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000288">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na21652b2719b457784918826a449e414">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_321:0000066"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">FlrFN  Measurement</rdfs:label>
    <ns1:definition xml:lang="en">1. A 7-gram sample of ground wheat or flour is weighed and combined with 25 milliliter of distilled water in a glass falling number tube with a stirrer and shaken to form a slurry.  When grinding a wheat sample to perform a falling number test, it should be at least 300 grams to assure a representative sample, 2. As the slurry is heated in a boiling water bath at 100° Centigrade and stirred constantly, the starch gelatinizes and forms a thick paste, 3. The time it takes the stirrer to drop through the paste is recorded as the falling number value.</ns1:definition>
  </ns2:Class>
