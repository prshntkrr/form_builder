    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
    <rdfs:label xml:lang="en">Stripe rust seedling response</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000643">
    <rdfs:label xml:lang="en">Grain screenings</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomic"/>
    <ns1:definition xml:lang="en">Proportion of small grain passing through a sieve.</ns1:definition>
    <ns4:entity>Grain</ns4:entity>
    <ns4:acronym xml:lang="en">GScreen</ns4:acronym>
    <ns4:attribute>Screenings proportion</ns4:attribute>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000158">
    <ns4:entity>Translocation 1BL/1RS</ns4:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Quality"/>
    <rdfs:label xml:lang="en">Translocation 1BL/1RS</rdfs:label>
    <ns4:acronym xml:lang="en">T1BL1RS</ns4:acronym>
    <ns1:definition xml:lang="en">The 1bl/1rs translocation in wheat resulted from replacing the short arm of the chromosome 1b of wheat by the short arm of the chromosome 1r of rye (Secale cereale l.).</ns1:definition>
    <ns4:attribute>Absence/Presence</ns4:attribute>
  </ns2:Class>
  <ns2:ObjectProperty rdf:about="https://cropontology.org/rdf/scale_of">
    <rdfs:label>scale_of</rdfs:label>
  </ns2:ObjectProperty>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0000672">
    <ns4:entity>Plant</ns4:entity>
    <rdfs:label xml:lang="en">Plant photoperiod response</rdfs:label>
    <ns1:definition xml:lang="en">Extent to which long days hasten flowering.</ns1:definition>
    <ns4:attribute>Photoperiod response</ns4:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns4:acronym xml:lang="en">PhotopResp</ns4:acronym>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_321:0001670">
    <ns1:definition xml:lang="en">The grain dry mass (grain yield) production per  Nitrogen available  to a plant.</ns1:definition>
    <ns4:attribute>Nitrogen Use Efficiency</ns4:attribute>
    <ns4:acronym xml:lang="en">NUE</ns4:acronym>
    <rdfs:label xml:lang="en">Nitrogen use efficiency</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns4:entity>Grain</ns4:entity>
  </ns2:Class>
