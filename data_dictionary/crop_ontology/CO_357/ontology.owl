    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N03a54985c55642779392ab81df3d2e89">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:2000043"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/scale_of"/>
