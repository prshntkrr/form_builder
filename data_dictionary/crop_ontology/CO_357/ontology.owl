    <rdfs:label xml:lang="en">Polycyclism on the terminal and lateral shoots and these lateral shoots remain dominated</rdfs:label>
    <ns1:altLabel xml:lang="en">2</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_357:3000008/07">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000008"/>
    <ns1:altLabel xml:lang="en">07</ns1:altLabel>
    <rdfs:label xml:lang="en">At least 50% of the foliar or mixed buds have burst. The green tips or bases of the leaves appear between the scales. In pines, the bud lengthens and the needles remain inside their sheath, which takes on a silvery hue; the green base of the needles can be seen. In other conifers, the needles begin to be visible.</rdfs:label>
  </rdf:Description>
