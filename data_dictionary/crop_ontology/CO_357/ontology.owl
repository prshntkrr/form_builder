  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000221">
    <ns1:definition xml:lang="en">Soil was spread in a fine layer and air-dried in the glasshouse until a constant weight was achieved. Minimum pot weight was considered to be pot’s weight containing a totally dry soil mixture. Maximum pot weight was measured when soil was at field capacity (FC)</ns1:definition>
    <rdfs:label xml:lang="en">Soil water availability</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf2210a16ff3f4b35a6f9962263964bb7">
