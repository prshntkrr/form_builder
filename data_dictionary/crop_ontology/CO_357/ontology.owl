  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000156">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N7ea51ebefb8e4d768bd35163a28de716">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000404"/>
