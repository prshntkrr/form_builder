    <ns1:definition xml:lang="en">Assessment of the date when shoots reached 20% of their final size (deducted a posteriori)</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000177">
    <rdfs:label xml:lang="en">BBCH_69 evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N0dc2ed07112e489eaa33e800a423f34c">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000024"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when 90% of flowers are sexually mature. For flowers with petals: petals are spread out and stamens release pollen. For male flowers in catkins: stamens are visible and release pollen. Other male flowers: stamens are visible and release pollen.</ns1:definition>
  </ns3:Class>
