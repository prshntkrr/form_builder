  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000042">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nabe2562e17bd40dcb78815f51bf5b75b">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000088"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Slope protocol</rdfs:label>
    <ns1:definition xml:lang="en">Starting at the tree, one member of the field team walks 5 meters down and another walks 5 meters upslope. The measure is done using a clinometer and looking at the other´s eyes.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000259">
    <ns2:entity>secondary bud</ns2:entity>
    <ns1:definition xml:lang="en">Assessment of secondary buds quantity. The secondary bud is present next to the primary bud within the compound bud and it is dormant until it is needed by the plant as a back up when the primary bud fails.</ns1:definition>
    <rdfs:label xml:lang="en">Secondary bud quantity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
