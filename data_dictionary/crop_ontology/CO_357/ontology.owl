    <rdfs:label xml:lang="en">Budflush date</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000066">
    <ns1:definition xml:lang="en">None</ns1:definition>
