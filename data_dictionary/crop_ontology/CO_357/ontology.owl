        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000264"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
