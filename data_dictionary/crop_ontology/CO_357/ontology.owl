        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Leaf gas exchange protocol at 300 µmol photons m−2 s−1</rdfs:label>
    <ns1:definition xml:lang="en">Leaf gas exchange was assessed with a portable infrared gas analyzer (LI-6400; LI-COR Inc., Lincoln, USA) equipped with a fluorometer (LI-6400-40, LI-COR Inc., Lincoln, USA). Data was periodically collected from the youngest fully expanded leaf (5–9 h after photoperiod initiation), never extending a total period of 90 min. Block temperature was set at 28°C, light intensity was set at 300 µmol photons m−2 s−1 and CO2 concentration was kept at 400 ppm with an air flow rate of 500 µmol s−1.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ne3ffbb88a4bf4b30ab1c8ab6a19317a9">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000302"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
