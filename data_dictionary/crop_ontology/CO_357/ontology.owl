    <ns2:acronym xml:lang="en">S/G</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000055">
    <rdfs:subClassOf>
