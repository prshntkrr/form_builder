    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Calculation of the mean of the 5 maximal values measured or computed</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000150">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N2bda4ec15343444a80f57b430861ef5e">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves are spread on about 90% of the crown. For pines: 90% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. For other conifers: 90% of buds with open-brushed needles.</ns1:definition>
    <rdfs:label xml:lang="en">BBCH_19 evaluation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000057">
