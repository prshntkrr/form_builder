  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000420">
    <ns2:acronym xml:lang="en">CHAL_nbF</ns2:acronym>
    <ns2:attribute>chalara</ns2:attribute>
    <ns1:definition xml:lang="en">Assessment of the influence of chalara on the leaves number</ns1:definition>
    <rdfs:label xml:lang="en">Chalara influence on leaves</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biotic_stress"/>
