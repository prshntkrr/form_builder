    <ns2:entity>plant</ns2:entity>
    <ns2:attribute>competition</ns2:attribute>
    <ns1:definition xml:lang="en">Appreciation of the space available for the tree to grow</ns1:definition>
    <ns2:acronym xml:lang="en">COMP</ns2:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Environmental"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000167">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nd7ccd3c328474f32928c6f80ba319c4a">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000024"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">BBCH_55 evaluation</rdfs:label>
    <ns1:definition xml:lang="en">Assessment of the date when the majority of floral buds have emerged from the buds but are closed. For flowers with petals: the majority of flower buds have emerged from the buds and are still closed, but the colour of the petals is visible. For male flowers in catkins: the catkins are at the end of lengthening, the scales begin to move apart. For other flowers: stamens begin to be visible.</ns1:definition>
  </ns3:Class>
