  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_357:3000026/85">
    <rdfs:label xml:lang="en">50% of the crown fruits are mature (has changed color or is dried and dehiscent or has fallen)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000026"/>
    <ns1:altLabel xml:lang="en">85</ns1:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_357:3000008/09">
    <ns1:altLabel xml:lang="en">09</ns1:altLabel>
    <rdfs:label xml:lang="en">At least 50% of the buds have the tips of the first leaves that extend beyond the tip of the scales, which may still be present. The leaves begin to individualize. In pines, the needles begin to pierce the sheath. In other conifers the first buds show individualized needles in closed brush.</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000008"/>
  </rdf:Description>
