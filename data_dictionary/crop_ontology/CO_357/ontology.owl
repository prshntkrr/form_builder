    <ns2:acronym xml:lang="en">N-debark</ns2:acronym>
    <rdfs:label xml:lang="en">Debarkings quantity</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000203">
    <ns1:definition xml:lang="en">Assessment of the date when 50% of the foliage turned color (color range depending) or fell</ns1:definition>
    <rdfs:label xml:lang="en">BBCH_95 evaluation</rdfs:label>
