      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">BBCH_35 evaluation</rdfs:label>
    <ns1:definition xml:lang="en">Assessment of the date when shoots reached 50% of their final size (deducted a posteriori)</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000039">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Na78628982dc84bb7ab24827d3eae24f3">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000084"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Competition protocol</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">The distance-dependent competition index is assessed by using the distance and diameter mesures of the 5 nearest neighbors to the target tree. It should also be specified whether they are conspecific or not with the sample tree.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000390">
    <ns2:entity>leaf</ns2:entity>
    <ns2:attribute>molecule content</ns2:attribute>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns1:definition xml:lang="en">Alpha copaene content</ns1:definition>
    <rdfs:label xml:lang="en">Alpha copaene content</rdfs:label>
    <ns2:acronym xml:lang="en">a.copaene</ns2:acronym>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000172">
    <rdfs:label xml:lang="en">BBCH_64 evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ne2c02dfc15944ca89dc285e8ef079e5f">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000024"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when 40% of flowers are sexually mature. For flowers with petals: petals are spread out and stamens release pollen. For male flowers in catkins: stamens are visible and release pollen. Other male flowers: stamens are visible and release pollen.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000425">
    <ns1:definition xml:lang="en">Rainfall on the site of the population</ns1:definition>
    <ns2:entity>population</ns2:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Environmental"/>
    <ns2:acronym xml:lang="en">Prec</ns2:acronym>
    <rdfs:label xml:lang="en">Rainfall</rdfs:label>
    <ns2:attribute>precipitation</ns2:attribute>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000137">
    <ns1:definition xml:lang="en">Assessment of the date when at least 10% of the bud burst. Leaves appear between the scales. In pines, the bud lengthens and the needles remain inside their sheath which takes a silver tint; we see the green base of the needles. In other conifers, the needles begin to be visible.</ns1:definition>
    <rdfs:label xml:lang="en">BBCH_06 evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N033c7af97dfc4e8ca7c359d89ada027d">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000071">
    <rdfs:label xml:lang="en">Sylleptic shoots quantity</rdfs:label>
    <ns2:acronym xml:lang="en">Syllep</ns2:acronym>
    <ns2:entity>sylleptic shoot</ns2:entity>
    <ns2:attribute>quantity</ns2:attribute>
    <ns1:definition xml:lang="en">Assessment of the sylleptic branches quantity, a shoot that develops from a lateral bud with any period of dormancy on the main shoot</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000412">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Fertility"/>
    <ns2:attribute>fructification</ns2:attribute>
    <ns1:definition xml:lang="en">Regularity of the fructification</ns1:definition>
    <rdfs:label xml:lang="en">Fructification regularity</rdfs:label>
    <ns2:acronym xml:lang="en">FRUC_REG</ns2:acronym>
    <ns2:entity>plant</ns2:entity>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000141">
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves of the crown are spread. For pines: first buds very elongated with the first needles coming out of the sheath the sheath glued in pairs. For other conifers: first buds showing open-brushed needles.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N2c2fc5edf6be4a41bfa3d7325ba2f618">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">BBCH_10 evaluation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000131">
    <ns1:definition xml:lang="en">The maximum value of a list of measured meteo values</ns1:definition>
