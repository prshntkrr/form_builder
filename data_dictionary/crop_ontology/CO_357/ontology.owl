  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000122">
    <rdfs:label xml:lang="en">Maximal mean value</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ncfae08d2c3144b438419975a2a25cdd9">
