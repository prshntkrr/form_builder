  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_357:3000021/61">
    <ns1:altLabel xml:lang="en">61</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000021"/>
    <rdfs:label xml:lang="en">10% of flowers are sexually mature. Flowers with petals: petals are spread out and stamens release pollen. Male flowers in catkins: stamens are visible and release pollen. Other male flowers: stamens are visible and release pollen.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://cropontology.org/rdf/CO_357:3000008/12">
    <ns1:altLabel xml:lang="en">12</ns1:altLabel>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/CO_357:3000008"/>
    <rdfs:label xml:lang="en">Broadleaves: the first leaves are spread on about 20% of the crown. Pines: 20% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. Other conifers: 20% of buds with open-brushed needles</rdfs:label>
  </rdf:Description>
