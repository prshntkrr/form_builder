  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000030">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N9b255e8bf83f46c2972954a013d62e93">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000043"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Calculation of the difference between 2 measured values of the same morphological observation (ex: circunference, height) at different times to evaluate the tree growth</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N862a1c03660542f68cf1e9c750474510">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000147"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
