        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000424"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Maximal meteo value</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000012">
    <ns1:definition xml:lang="en">Circumference of the tree main stem</ns1:definition>
    <ns2:acronym xml:lang="en">CIR</ns2:acronym>
    <ns2:entity>stem</ns2:entity>
    <ns2:attribute>circumference</ns2:attribute>
    <rdfs:label xml:lang="en">Tree circumference</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000207">
    <rdfs:label xml:lang="en">BBCH_99 evaluation</rdfs:label>
