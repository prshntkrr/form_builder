      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Mean wood density</rdfs:label>
    <ns1:definition xml:lang="en">Calculation of the mean ring, latewood or earlywood density weighted by the ring surface</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N4adc0509928f4df9a964dc3b7492aec7">
