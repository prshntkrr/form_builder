  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000149">
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves are spread on about 80% of the crown. For pines: 80% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. For other conifers: 80% of buds with open-brushed needles.</ns1:definition>
    <rdfs:label xml:lang="en">BBCH_18 evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf762242f04114f5797c57ac55b47daa9">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
