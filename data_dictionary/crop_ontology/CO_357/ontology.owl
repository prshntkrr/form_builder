  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000217">
    <rdfs:label xml:lang="en">ETR protocol</rdfs:label>
    <ns1:definition xml:lang="en">Standard method for gas exchange and fluorescence measurements. PPFD is the photon flux density of photosynthetically active radiation (400–700 nm), 0.84 is the assumed light absorbance of the sample, and 0.5 is the fraction of excitation energy diverted to the photosystem II</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
