  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000130">
    <ns2:entity>cork</ns2:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns1:definition xml:lang="en">Chemical composition in polysacharide</ns1:definition>
