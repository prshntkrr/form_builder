    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Environmental"/>
    <ns2:acronym xml:lang="en">soil_depth</ns2:acronym>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000393">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns2:attribute>molecule content</ns2:attribute>
    <rdfs:label xml:lang="en">Alpha pinene content</rdfs:label>
    <ns2:entity>leaf</ns2:entity>
    <ns1:definition xml:lang="en">Alpha pinene content</ns1:definition>
    <ns2:acronym xml:lang="en">a.pinene</ns2:acronym>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000140">
    <rdfs:label xml:lang="en">BBCH_09 evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N941701513be5439d8d9b3e100bc9af5e">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Assessment of the date when at least 50% of the buds have the tips of the first leaves that extend beyond the tip of the scales, which may still be present. The leaves begin to individualize. In pines, the needles begin to pierce the sheath. In other conifers the first buds show individualized needles in closed brush.</ns1:definition>
  </ns3:Class>
  <ns3:ObjectProperty rdf:about="https://cropontology.org/rdf/method_of">
    <rdfs:label>method_of</rdfs:label>
  </ns3:ObjectProperty>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000146">
    <rdfs:label xml:lang="en">BBCH_15 evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nb482639dd64f472c917d4b417123ca34">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves are spread on about 50% of the crown. For pines: 50% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. For other conifers: 50% of buds with open-brushed needles.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000171">
    <rdfs:label xml:lang="en">BBCH_63 evaluation</rdfs:label>
    <ns1:definition xml:lang="en">Assessment of the date when 30% of flowers are sexually mature. For flowers with petals: petals are spread out and stamens release pollen. For male flowers in catkins: stamens are visible and release pollen. Other male flowers: stamens are visible and release pollen.</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nf0135f94b22c47aabf7be04d48e1ce63">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000024"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000304">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns2:attribute>electron transport</ns2:attribute>
