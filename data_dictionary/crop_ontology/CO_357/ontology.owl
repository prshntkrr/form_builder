  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000192">
    <rdfs:label xml:lang="en">BBCH_84 evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <ns1:definition xml:lang="en">Assessment of the date when 40% of the crown fruits are mature (has changed color or is dried and dehiscent or has fallen)</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N4c634ef98d0846b0aa082894be977bb3">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000031"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000028">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns2:acronym xml:lang="en">FO_index</ns2:acronym>
    <ns2:attribute>forking index</ns2:attribute>
    <ns2:entity>plant</ns2:entity>
    <ns1:definition xml:lang="en">Combination of the forking position and the number of forks, the highest index being for non-forking trees and for trees with a lower number of forks at a higher position</ns1:definition>
    <rdfs:label xml:lang="en">Forking index</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000032">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N388f002fd40949ab877528b2ce2543db">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000031"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <ns1:definition xml:lang="en">Number of mature fruits/cones that you are able to count on the tree in 30 seconds from the ground using binoculars</ns1:definition>
    <rdfs:label xml:lang="en">Fruits/Cones protocol</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000239">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns2:acronym xml:lang="en">SHDM</ns2:acronym>
    <ns2:entity>shoot</ns2:entity>
    <ns1:definition xml:lang="en">Shoot dry mass</ns1:definition>
    <rdfs:label xml:lang="en">Shoot dry mass</rdfs:label>
    <ns2:attribute>dry mass</ns2:attribute>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:3000033">
