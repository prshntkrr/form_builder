    <rdfs:label xml:lang="en">BBCH_90 evaluation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000144">
    <rdfs:label xml:lang="en">BBCH_13 evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N9b8037cc41e94bcf9883e03a6f6bb7c9">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves are spread on about 30% of the crown. For pines: 30% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. For other conifers: 30% of buds with open-brushed needles.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000112">
    <ns1:definition xml:lang="en">Ratio between Syringyl (S) and Guaiacyl (G) contents</ns1:definition>
    <ns2:entity>wood</ns2:entity>
    <rdfs:label xml:lang="en">Syringaldehyde/Coniferaldehyde contents</rdfs:label>
