    <ns1:definition xml:lang="en">Assessment of the date when 90% of the foliage turned color (color range depending) or fell</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000044">
    <ns2:acronym xml:lang="en">IH</ns2:acronym>
    <ns2:entity>plant</ns2:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns1:definition xml:lang="en">Height increase by the growth of the tree main stem</ns1:definition>
    <ns2:attribute>height</ns2:attribute>
    <rdfs:label xml:lang="en">Height increment</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000300">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Physiological"/>
    <ns2:acronym xml:lang="en">Leaf_CO2_curve</ns2:acronym>
    <ns1:definition xml:lang="en">Leaf CO2 light response curve</ns1:definition>
    <rdfs:label xml:lang="en">Leaf CO2 light response curve</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000138">
    <ns1:definition xml:lang="en">Assessment of the date when at least 50% of the foliar or mixed buds have burst. The green tips or bases of the leaves appear between the scales. In pines, the bud lengthens and the needles remain inside their sheath, which takes on a silvery hue; the green base of the needles can be seen. In other conifers, the needles begin to be visible.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N1f000a0551ee469aae7544c2924480cd">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">BBCH_07 evaluation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000072">
    <ns1:definition xml:lang="en">Measurement of the deviation from the verticality</ns1:definition>
    <rdfs:label xml:lang="en">Deviation from verticality</rdfs:label>
    <ns2:attribute>deviation verticality</ns2:attribute>
    <ns2:acronym xml:lang="en">VER</ns2:acronym>
    <ns2:entity>plant</ns2:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000007">
