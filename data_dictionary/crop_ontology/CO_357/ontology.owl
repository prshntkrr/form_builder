    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N5b4d88945ad24726a61e51252b1a8d0b">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000006"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">BBCH_11 evaluation</rdfs:label>
    <ns1:definition xml:lang="en">Assessment of the date when leaves are coming out of their bud. For broadleaves: the first leaves are spread on about 10% of the crown. For pines: 10% of very elongated buds with first needles coming out or out of the sheath but still tight, as stuck between them. For other conifers: 10% of buds with open-brushed needles.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
