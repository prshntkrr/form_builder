    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Nominal"/>
    <rdfs:label xml:lang="en">Regeneration scoring scale</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:3000094">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N6c3e7c582f8742649078d62743ce6beb">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:2000003"/>
