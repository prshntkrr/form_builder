    <ns2:acronym xml:lang="en">BF_score</ns2:acronym>
    <ns2:attribute>break</ns2:attribute>
    <rdfs:label xml:lang="en">Budflush</rdfs:label>
    <ns1:definition xml:lang="en">Assessment of the bud break level</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Phenological"/>
    <ns2:entity>bud</ns2:entity>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:3000058">
