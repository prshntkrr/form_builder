  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000110">
    <rdfs:label xml:lang="en">Independant cover protocol</rdfs:label>
    <ns1:definition xml:lang="en">Plant and rock covers are assessed independently in the 10x10 m virtual plot around the tree and with a predefined scoring scale. As the estimations are independent, the total of the two can be &gt; 100% (some plants can grow over rocks).</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nec7b1fe8a2564ed2a575d81ad3964f77">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000090"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000218">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Water content (WC) measurements were performed according to Levitt, 1980. FW: Fresh weight of plant material was determined at the end of the experiment (day 35). DW: Dry weight (g) was determined after drying plant material at 70°C (until a constant weight was achieved).</ns1:definition>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N53c6a864c14e4103af3d8d298606dd30">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000293"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Water content protocol</rdfs:label>
    <rdfs:subClassOf>
