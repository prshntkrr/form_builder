    <rdfs:label xml:lang="en">BBCH_38 evaluation</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000170">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:label xml:lang="en">BBCH_62 evaluation</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N06b1cea0aa904bcaa2469562140e4153">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000024"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Assessment of the date when 20% of flowers are sexually mature. For flowers with petals: petals are spread out and stamens release pollen. For male flowers in catkins: stamens are visible and release pollen. Other male flowers: stamens are visible and release pollen.</ns1:definition>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:3000098">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Na1d1ccaa9e494991aa35ea5075a9e5fd">
