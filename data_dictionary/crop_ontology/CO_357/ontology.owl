  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000179">
    <ns2:entity>plant</ns2:entity>
    <ns2:attribute>sympodic</ns2:attribute>
    <ns1:definition xml:lang="en">Assessment of sympodic growth. The apparent main axis is not developed from a terminal bud but transferred to a lateral meristem made up of successive secondary axes each of which represents one fork of a dichotomy, the other being of weaker growth or suppressed entirely.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
    <ns2:acronym xml:lang="en">sympodic</ns2:acronym>
    <rdfs:label xml:lang="en">Sympodial growth</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000125">
    <rdfs:label xml:lang="en">Fork height protocol</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Nc2f77d1908bd474a8e87adbb2051214b">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000040"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Observation of the fork presence or absence. If the fork is gone and not transformed into a large branch, the value will be 0. If the fork is gone but transformed into a large branch, the value will be 1. If the fork is still present, its height from tree collar must be measured and the value will be the fork height.</ns1:definition>
  </ns3:Class>
