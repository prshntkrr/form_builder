    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">linha</rdfs:label>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000258">
    <ns2:entity>primary bud</ns2:entity>
    <ns2:acronym xml:lang="en">PriBD</ns2:acronym>
    <rdfs:label xml:lang="en">Primary bud quantity</rdfs:label>
    <ns2:attribute>quantity</ns2:attribute>
    <ns1:definition xml:lang="en">Assessment of primary buds quantity. The primary bud is the first to grow after the winter dormant period and is the most likely to develop a robust shoot during the growing season.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000268">
