  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000129">
    <rdfs:label xml:lang="en">Slenderness protocol</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="Ne1b952f91dde40349669315d34aa86fb">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000421"/>
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">The slenderness of a tree is calculated by dividing its total height by its diameter at 1.30 m. Note that both values must be measured with the same unit.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000197">
    <ns2:acronym xml:lang="en">DOC</ns2:acronym>
    <ns1:definition xml:lang="en">Dissolved oxygen content in leaves</ns1:definition>
