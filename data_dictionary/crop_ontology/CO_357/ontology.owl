  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000063">
    <rdfs:label xml:lang="en">Cork Porosity protocol</rdfs:label>
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N82b39f868fdd41eb8229355b91e569d7">
        <ns3:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000120"/>
      </ns3:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Image acquisition of the two radial, two transversal and one tangential sections was made through scanning at a minimum resolution of 300 dpi. Images were uploaded and then analysed using ImageProPlus1(Media Cybernetics, USA) image-processing software.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns3:Class>
