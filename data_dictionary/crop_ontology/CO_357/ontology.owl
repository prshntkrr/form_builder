  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:1000409">
    <ns2:acronym xml:lang="en">Fis</ns2:acronym>
    <rdfs:label xml:lang="en">Fixation index</rdfs:label>
    <ns2:entity>population</ns2:entity>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
    <ns1:definition xml:lang="en">Assessment of the panmixia (or panmicticism) standard deviation. It is the ability of individuals in a population to interbreed without restrictions; individuals are able to move about freely within their habitat, possibly over a range of hundreds to thousands of miles, and thus breed with other members of the population</ns1:definition>
    <ns2:attribute>panmixia</ns2:attribute>
  </ns3:Class>
