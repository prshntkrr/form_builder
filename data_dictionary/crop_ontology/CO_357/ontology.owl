    <ns1:definition xml:lang="en">Shoot diameter</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Morphological"/>
  </ns3:Class>
  <ns3:Class rdf:about="https://cropontology.org/rdf/CO_357:2000107">
    <rdfs:subClassOf>
      <ns3:Restriction rdf:nodeID="N8099f7806fab418383e3b11a2133e493">
        <ns3:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_357:1000374"/>
