    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Measured with a pilodyn with 3 repetitions</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Pilodyn protocol</rdfs:label>
  </ns3:Class>
