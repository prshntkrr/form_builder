  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000375">
    <rdfs:label xml:lang="en">SCond - Measurement</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Measured with a portable porometer. Take the measures in the middle between leaf tip and leaf base, and in between leaf midrib and leaf rim. Blade sections measured must to be exposed to sunlight for at least the 30 minutes before. Measurements always performed in the same side of the leaf (usually the lower or abaxial one). One measurement per leaf, and at least 3 per plot. 1 min per measurement.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N942ea4dea8dd4e8c847573fd8b5c3754">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000134"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
