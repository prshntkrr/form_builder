    <rdfs:label xml:lang="en">ASI - Computation</rdfs:label>
    <ns1:definition xml:lang="en">Count number of days from planting date to anthesis and silking to determine days to anthesis (DTA) and days to silking (DTS), respectively and determine anthesis silking interval (ASI) by calculating: ASI = DTS-DTA.</ns1:definition>
  </ns2:Class>
