  <ns2:ObjectProperty rdf:about="https://cropontology.org/rdf/method_of">
    <rdfs:label>method_of</rdfs:label>
  </ns2:ObjectProperty>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000018">
    <ns4:attribute>aspect</ns4:attribute>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Agronomic">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Trait"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Observation of harvested ears based on some morphological and agronomical characters such as ear size, total numbers of ear harvested per plot, ear damaged caused by insects or/and diseases.</ns1:definition>
    <ns4:acronym xml:lang="en">EAsp</ns4:acronym>
    <rdfs:label xml:lang="en">Ear aspect</rdfs:label>
    <ns4:entity>Ear</ns4:entity>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000549">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na578931b4eba4f668f9b7d7f8a0a03d6">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000938"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Counting"/>
    <rdfs:label xml:lang="en">StrigaPN - Counting</rdfs:label>
    <ns1:definition xml:lang="en">Count the total number of emerged striga plants per plot. It is counted three times, 8 weeks, 10 weeks and 12 weeks after planting.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000193">
    <rdfs:label xml:lang="en">SLodgInc - Computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N39cf723940c04d9c9fb9f5849e1d3e46">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000035"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Divide the total numbers of plants with lodged stems by number of plants harvested.</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000213">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N22293de44012432aa18d807f1a9f972e">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000168"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Score the grains based on grain characters such as floury, dent per plot.</ns1:definition>
    <rdfs:label xml:lang="en">GTyp - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000301">
    <ns1:definition xml:lang="en">Divide the total number of DMS damaged plants by the total number of plants harvested.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N970e4fec6a7347ef8cb3993b4c0a04cb">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_322:0000080"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">DMSInc - Computation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_322:0000285">
    <ns1:definition xml:lang="en">Observe the maize plant damage caused by striga per plot.</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N94652a655e0640c0b7310bdcb13b9b6e">
