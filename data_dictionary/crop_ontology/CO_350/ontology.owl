    <ns1:definition xml:lang="en">Measurement of the amount of time it takes for a viscometer stirrer to fall a set distance through an aqueous gel created using groat flour. This indirectly measures the alpha amylase content of the groat, which becomes more abundant in grains that have suffered pre-harvest sprouting. An increase in alpha amylase in groat flour, along with other hydrolytic enzymes that are associated with pre-harvest sprouting, reduces the quality of the flour.</ns1:definition>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nad5ac72bddd44d3e92c84021a95cc6f7">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_350:0005423"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <rdfs:label xml:lang="en">Groat flour falling number determination</rdfs:label>
  </ns2:Class>
