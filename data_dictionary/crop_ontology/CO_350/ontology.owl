      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Computation of the percentage of seed that is effectively dehulled by a Codema dehuller, calculated as the mass of seed before dehulling minus the amount of undehulled seed after processing, divided by the total mass before dehulling, and multiplied by 100 to give the percentage of seed that was successfully dehulled.</ns1:definition>
    <rdfs:label xml:lang="en">Dehulling efficiency computation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
