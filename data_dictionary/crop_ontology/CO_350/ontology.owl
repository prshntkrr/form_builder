    <ns1:definition xml:lang="en">Observe relative or absolute area of plant tissue affected by Barley yellow dwarf virus and record it. Often severity is represented as a proportion or percentage of plant surface affected.</ns1:definition>
    <rdfs:label xml:lang="en">Barley yellow dwarf virus severity - Estimation</rdfs:label>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_350:0005628">
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nf3ceac44361e4d5a97d75c3ff7a89353">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_350:0000090"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Estimation of the percentage of the area of the flag leaf occupied by crown rust (Puccinia coronata f. sp. avenae) pustules or necrosis, following the modified Cobb scale (Peterson et al. 1948) and recorded in conjunction with crown rust infection response. Common intervals: trace (0.1 in T3), 5, 10, 20, 40, 60, and 100 percent infection.</ns1:definition>
    <rdfs:label xml:lang="en">Crown rust flag leaf severity estimation</rdfs:label>
  </ns2:Class>
