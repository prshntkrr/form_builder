  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3100018">
    <rdfs:label xml:lang="en">Phoma stem cancer severity - Estimation</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N40f208d5518e4dfc85b4d20e37e70c8e">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2100089"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">Six plants per plot were assessed for severity of phoma stem canker on the base of the stem. For assessing the base stem canker severity, the stem were cut at the stem base, the cross-section was scored on a 0-7 scale  ( 0= no symptoms observable, 1 = ≤ 5% girdling,2= 2-25% girdling, 3=26-50% girdling, 4=51-75% girdling, 5= 75-100% girdling, 6=100% girdling ( stem weak/firm), 7 = 100% girdling (stem dead/lodged))</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:2100076">
