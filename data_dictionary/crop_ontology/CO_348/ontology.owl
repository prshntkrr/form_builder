  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3100017">
    <rdfs:label xml:lang="en">Leaf phoma resistance - Estimation</rdfs:label>
    <ns1:definition xml:lang="en"><![CDATA[10 plants from each plot were sampled and the Phoma leaf spot severity was assessed on a 0-3 scale: 0 = No leaf spotting, 1 =<5 spots per plant, 2=5-10 spots per plant, 3 = >10 spots per plant]]></ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N0e103d5ceddf4fddb50cb778591e6119">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2100088"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
  </ns2:Class>
