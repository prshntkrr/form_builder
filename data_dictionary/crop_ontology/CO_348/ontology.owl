      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Pedicel length - Measurement</rdfs:label>
    <ns1:definition xml:lang="en">Measurement of mean length of pedicel (cm),  using SigmaScan from digital image of 10 typical pods from terminal raceme or primary raceme if terminal was damaged</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3100012">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Nac11feaa5b964f9e91a7089f5125a82d">
