        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">10 plants from each plot were assessed on % incidence with light leaf spot (LLS). The incidence of LLS on leaves was recorded based on presence/absence of LLS.  For example, 4 out 10 plants with phoma, the incidence of phoma will be 40%.</ns1:definition>
    <rdfs:label xml:lang="en">LLS incidence (diseased) - Estimation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Estimation"/>
  </ns2:Class>
