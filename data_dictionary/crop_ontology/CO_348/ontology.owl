        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2100028"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">3 seeds per tube and occasionally four for verry small seeds from multiple replicate plants per accession were left to soak in nitric acid over night and then digested in block heaters prior to analysis by inductively coupled plasma-mass spectrometry (ICP-MS). This data was then weight normalised so that data from each element was in the units mg/kg</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:2100059">
    <ns4:entity>Seed</ns4:entity>
    <ns4:attribute>Campesterol content</ns4:attribute>
    <ns1:definition xml:lang="en">The concentration of Campesterol in seeds</ns1:definition>
    <ns1:altLabel xml:lang="en">Campesterol</ns1:altLabel>
    <rdfs:label xml:lang="en">Seed Campesterol content</rdfs:label>
    <ns4:acronym xml:lang="en">SdCampesterol</ns4:acronym>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Biochemical"/>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3000030">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Na2f68ba356b34de1a13d264bbcc1d781">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2000028"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
    <ns1:definition xml:lang="en">Differential weighing. A sample of around 200 grammes ofdrymature seeds is weighted before and after cleaning using a column in order to determine the gross weight (GWg) and the net weight (NWg) respectively</ns1:definition>
    <rdfs:label xml:lang="en">Seed impurity content – Computation</rdfs:label>
  </ns2:Class>
