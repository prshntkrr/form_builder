  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3000004">
    <rdfs:label xml:lang="en">Plant height - Measurement</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N32edc32ef55c4ab6a31177edcc1b82f5">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2100125"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Measurement"/>
    <ns1:definition xml:lang="en">Height is measured from ground to the top of the plants using a dipstick graduated in cm</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_348:3000029">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Naa1172e628644a7f8a738db95c57a7b4">
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2000027"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
    <rdfs:label xml:lang="en">Seed moisture content – Computation</rdfs:label>
    <ns1:definition xml:lang="en">Differential weighing. A sample of around 5 grammes of cleaned dry mature seeds is weighted before and after drying at 103°C for  15 hours in order to determine the fresh weight (FWg) and the dry weight (DWg) respectively</ns1:definition>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Computation"/>
  </ns2:Class>
