    <rdfs:label xml:lang="en">Seed mineral analysis - Measurement</rdfs:label>
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="N9367fa20606f486a954c11bbcac2ee44">
        <ns2:someValuesFrom rdf:resource="https://cropontology.org/rdf/CO_348:2100008"/>
        <ns2:onProperty rdf:resource="https://cropontology.org/rdf/method_of"/>
      </ns2:Restriction>
    </rdfs:subClassOf>
