  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_367:0000107">
    <rdfs:label xml:lang="en">Plant above-ground dry biomass</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Agronomical"/>
    <ns4:attribute>Above-ground dry biomass</ns4:attribute>
    <ns4:acronym xml:lang="en">AGDBM</ns4:acronym>
    <ns4:entity>Plant</ns4:entity>
    <ns1:definition xml:lang="en">Cutting plants at the very base with secateurs and drying the entire above-ground section of the plant. Recording total dry weight and number of plants that make up total dry weight. Divide total weight with number of plants to give weight per plant</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_367:0000139">
    <rdfs:label xml:lang="en">Seed average red color</rdfs:label>
