  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_367:0000034">
    <ns4:entity>Panicle</ns4:entity>
    <rdfs:label xml:lang="en">Panicle axis angle</rdfs:label>
    <ns4:acronym xml:lang="en">PcleAng</ns4:acronym>
    <ns4:attribute>Axis angle</ns4:attribute>
    <rdfs:subClassOf>
      <rdf:Description rdf:about="https://cropontology.org/rdf/Abiotic_stress">
        <rdfs:subClassOf rdf:resource="https://cropontology.org/rdf/Trait"/>
      </rdf:Description>
    </rdfs:subClassOf>
    <ns1:definition xml:lang="en">The angle at which the majority of panicle axes are leaning, measured between an upright panicle on the verticle and a panicle pointing towards the ground</ns1:definition>
  </ns2:Class>
  <ns2:Class rdf:about="https://cropontology.org/rdf/CO_367:0000039">
    <rdfs:subClassOf>
      <ns2:Restriction rdf:nodeID="Ncc56eb2e3e834ba6a13dd1dee608598c">
