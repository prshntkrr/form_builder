# Template only — copy to .env and fill in real values there.
# .env is gitignored; this file is not. Never put a real password or key here.

# --- Postgres (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_agrology
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_SCHEMA=public
DB_POOL_MIN=1
DB_POOL_MAX=10
# Run schema.sql at startup to create `forms` and `form_version` if absent.
# Set to false if the app's database user is not allowed to run DDL — then
# apply schema.sql yourself before starting.
AUTO_CREATE_TABLES=true

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=90

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_USER=system

# --- Auth ---
APP_URL=http://localhost:5173
SESSION_HOURS=12
RESET_MINUTES=60
# Modules to switch off, comma-separated. A module named here is not loaded at
# all: no routes, no permissions, no tables, and the UI hides its screens. Use it
# to keep work in progress away from a client without maintaining a branch.
#   DISABLED_MODULES=dashboards
DISABLED_MODULES=

ADMIN_EMAIL=admin@example.org
# Leave blank on first run and one is generated and printed to the log.
ADMIN_PASSWORD=
# Local development only: returns reset links in the API response.
AUTH_EXPOSE_RESET_LINK=false

# --- Email (optional). Without SMTP_HOST, reset links go to the log. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# MCDC, the multi-channel collection layer a published form can be exported to.
# Without a base URL the connector refuses rather than inventing an address.
# The key is sent as a bearer header, and never reaches a browser or a form.
MCDC_BASE_URL=
MCDC_API_KEY=
MCDC_TIMEOUT=20

# The boundary channel traffic crosses (app/core/gateway.py). Not a proxy:
# middleware in front of the routes MCDC, mobile, WhatsApp and IVR reach.
# The rate limit counts per principal, in this process — see MCDC_GATEWAY.md
# before running more than one instance.
MCDC_GATEWAY_ENABLED=true
MCDC_GATEWAY_MAX_BODY_MB=5
MCDC_GATEWAY_RATE_LIMIT=120
MCDC_GATEWAY_RATE_WINDOW_SECONDS=60
MCDC_GATEWAY_CONNECT_TIMEOUT=5
MCDC_GATEWAY_READ_TIMEOUT=30
