# ── secrets ──────────────────────────────────────────────────────────────────
# Real credentials live in .env; .env.example is the tracked template.
.env
.env.*
!.env.example

# ── python ───────────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── downloaded models ────────────────────────────────────────────────────────
# The speaker-embedding model for voice sign-in: 26 MB of weights, identical on
# every installation, and fetched once by the command in requirements.txt. Not
# in git because a binary that large is not worth a repository's history, and
# nothing here modifies it.
backend/models/*.onnx

# ── node / frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*
.eslintcache
**/vite.config.js

# ── editors & os ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── tooling ──────────────────────────────────────────────────────────────────
.claude/settings.local.json

# ── local scratch ────────────────────────────────────────────────────────────
*.log
tmp/

# ── load testing ─────────────────────────────────────────────────────────────
# Generated credentials for the dedicated load-test accounts. Never commit.
load_tests/users.csv
load_tests/users.tmp
load_tests/results/
results/

# Load-test accounts: generated, and real passwords.
load_tests/users.csv
load_tests/__pycache__/

# The frontend dev-server config is edited on each machine (ports, allowed
# hosts), so it is not tracked. frontend/vite.config.example.js is the template;
# the deploy copies it when a machine has no config of its own, and keeps the
# one already there.
frontend/vite.config.js
